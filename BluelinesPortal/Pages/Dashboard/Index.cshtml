@page
@model BluelinesPortal.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "My Dashboard";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.5rem;
    }

    .table-custom th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #6c757d;
        border-bottom: 2px solid #f8f9fa;
    }

    .table-custom td {
        vertical-align: middle;
        padding: 1rem 0.5rem;
    }
</style>

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Welcome back, <span class="text-gradient">@Model.CurrentStudent.FullName!</span></h2>
        <p class="text-muted mb-0">Track your applications, monitor your progress, and jump back into your workspace.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-page="/Programs/OpportunityBoard" class="btn btn-gradient shadow-sm rounded-pill px-4 fw-bold">
            <i class="bi bi-compass me-1"></i> Browse Opportunities
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0 bg-success bg-opacity-10 text-success fw-bold" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-5">
    <div class="col-lg-5">
        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-muted fw-bold mb-1">Applications</h6>
                            <h2 class="fw-bold text-dark mb-0">@Model.MyApplications.Count()</h2>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-inbox"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="glass-card p-4 h-100 border-bottom border-success border-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-muted fw-bold mb-1">Active Projects</h6>
                            <h2 class="fw-bold text-success mb-0">
                                @Model.MyApplications.Count(a => a.Status == BluelinesPortal.Models.ApplicationStatus.Enrolled)
                            </h2>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-laptop"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card p-4">
            <h6 class="fw-bold text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i> Status Breakdown</h6>
            @if (Model.MyApplications.Any())
            {
                <div style="position: relative; height: 220px; width: 100%;">
                    <canvas id="statusChart"></canvas>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bar-chart text-light opacity-50 display-1 mb-3 d-block"></i>
                    <p class="mb-0">No data to chart yet.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <div class="glass-card h-100 d-flex flex-column">
            <div class="p-4 border-bottom border-light">
                <h5 class="fw-bold mb-0"><i class="bi bi-list-ul me-2 text-primary"></i> Application History</h5>
            </div>
            <div class="p-0 flex-grow-1 overflow-auto">
                <table class="table table-hover table-custom mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Program</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MyApplications != null && Model.MyApplications.Any())
                        {
                            foreach (var app in Model.MyApplications)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@app.Program.Title</div>
                                        <div class="small text-muted">Applied: @app.AppliedOn.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td>
                                        @switch (app.Status)
                                        {
                                            case BluelinesPortal.Models.ApplicationStatus.Pending:
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                                                break;
                                            case BluelinesPortal.Models.ApplicationStatus.UnderReview:
                                                <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="bi bi-eye me-1"></i> Reviewing</span>
                                                break;
                                            case BluelinesPortal.Models.ApplicationStatus.Approved:
                                                <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-check-circle me-1"></i> Offer Ready</span>
                                                break;
                                            case BluelinesPortal.Models.ApplicationStatus.Enrolled:
                                                <span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-rocket-takeoff me-1"></i> Active</span>
                                                break;
                                            case BluelinesPortal.Models.ApplicationStatus.Rejected:
                                                <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i> Closed</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (app.Status == BluelinesPortal.Models.ApplicationStatus.Approved || app.Status == BluelinesPortal.Models.ApplicationStatus.Enrolled)
                                        {
                                            <a asp-page="/Student/MakePayment" asp-route-applicationId="@app.Id" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3 shadow-sm me-1 mb-1">
                                                <i class="bi bi-cash me-1"></i> Fees
                                            </a>
                                        }

                                        @if (app.Status == BluelinesPortal.Models.ApplicationStatus.Approved)
                                        {
                                            <a asp-page="/Student/AcceptOffer" asp-route-id="@app.Id" class="btn btn-sm btn-dark fw-bold rounded-pill px-3 shadow-sm mb-1">Offer</a>
                                        }
                                        else if (app.Status == BluelinesPortal.Models.ApplicationStatus.Enrolled)
                                        {
                                            <a asp-page="/Workspace/Index" asp-route-id="@app.Id" class="btn btn-sm btn-gradient fw-bold rounded-pill px-3 shadow-sm mb-1">Workspace <i class="bi bi-arrow-right ms-1"></i></a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-dash"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-muted mb-3">You haven't applied for any programs yet.</div>
                                    <a asp-page="/Programs/OpportunityBoard" class="btn btn-outline-primary rounded-pill px-4">Explore Available Programs</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Only initialize the chart if there is data
        @if (Model.ChartData.Any())
        {
                <text>
                document.addEventListener("DOMContentLoaded", function () {
                    const ctx = document.getElementById('statusChart').getContext('2d');

                    // Use Razor to inject the C# data lists directly into JavaScript arrays
                    const labels = @Html.Raw(Json.Serialize(Model.ChartLabels));
                    const dataPoints = @Html.Raw(Json.Serialize(Model.ChartData));

                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: dataPoints,
                                backgroundColor: [
                                    '#0d6efd', // Primary
                                    '#198754', // Success
                                    '#ffc107', // Warning
                                    '#0dcaf0', // Info
                                    '#dc3545'  // Danger
                                ],
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: {
                                        usePointStyle: true,
                                        boxWidth: 8,
                                        padding: 20,
                                        font: { family: "'Segoe UI', Roboto, Helvetica, Arial, sans-serif", size: 12 }
                                    }
                                }
                            },
                            cutout: '70%'
                        }
                    });
                });
                </text>
        }
    </script>
}