@page
@model BluelinesPortal.Pages.Programs.OpportunityBoardModel
@{
    ViewData["Title"] = "Opportunity Board";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(13, 110, 253, 0.1);
        }

    .program-thumbnail {
        height: 200px;
        object-fit: cover;
        border-top-left-radius: 1.25rem;
        border-top-right-radius: 1.25rem;
    }
</style>

<div class="text-center mb-5">
    <h1 class="fw-bold text-dark mb-3">Opportunity Board</h1>
    <p class="text-muted lead">Discover our latest internships, projects, and premium courses.</p>
</div>

<div class="row g-4 mb-5">
    @if (Model.ActivePrograms != null && Model.ActivePrograms.Any())
    {
        foreach (var program in Model.ActivePrograms)
        {
            // --- DYNAMIC PRICING MATH ---
            decimal displayPrice = program.BaseFee;
            bool hasAutoDiscount = program.IsDiscountActive && string.IsNullOrEmpty(program.CouponCode);
            bool hasPromoCode = program.IsDiscountActive && !string.IsNullOrEmpty(program.CouponCode);

            if (hasAutoDiscount)
            {
                if (program.DiscountType == BluelinesPortal.Models.DiscountType.Percentage)
                {
                    displayPrice = program.BaseFee - ((program.BaseFee * program.DiscountValue) / 100);
                }
                else if (program.DiscountType == BluelinesPortal.Models.DiscountType.FixedAmount)
                {
                    displayPrice = program.BaseFee - program.DiscountValue;
                }
            }
            if (displayPrice < 0) displayPrice = 0;

            <div class="col-md-6 col-lg-4">
                <div class="glass-card h-100 d-flex flex-column position-relative">

                    <!-- PROMO CODE BADGE -->
                    @if (hasPromoCode)
                    {
                        <div class="position-absolute top-0 end-0 mt-3 me-3 z-index-1">
                            <span class="badge bg-warning text-dark fw-bold px-3 py-2 shadow-sm rounded-pill border border-white">
                                <i class="bi bi-ticket-perforated me-1"></i> Use Code: @program.CouponCode
                            </span>
                        </div>
                    }

                    <!-- Thumbnail -->
                    @if (!string.IsNullOrEmpty(program.ThumbnailPath))
                    {
                        <img src="@program.ThumbnailPath" class="card-img-top program-thumbnail" alt="@program.Title">
                    }
                    else
                    {
                        <div class="bg-light d-flex justify-content-center align-items-center program-thumbnail">
                            <i class="bi bi-image text-muted display-4 opacity-25"></i>
                        </div>
                    }

                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">@program.Type</span>
                            <span class="text-muted small fw-bold"><i class="bi bi-calendar3 me-1"></i> @program.DurationInDays Days</span>
                        </div>

                        <h5 class="fw-bold text-dark mt-2 mb-3">@program.Title</h5>
                        <p class="text-muted small flex-grow-1">@(program.ShortDescription ?? "Explore this amazing opportunity and upgrade your skills today.")</p>

                        <!-- Pricing Display -->
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                            <div>
                                @if (hasAutoDiscount)
                                {
                                    <span class="text-muted text-decoration-line-through small me-2">₹@program.BaseFee.ToString("0")</span>
                                    <span class="fw-bold text-success fs-5">₹@displayPrice.ToString("0")</span>
                                    <div class="text-success small fw-bold mt-1">
                                        <i class="bi bi-tags-fill me-1"></i>
                                        @(program.DiscountType == BluelinesPortal.Models.DiscountType.Percentage ? $"{program.DiscountValue}% OFF" : $"Save ₹{program.DiscountValue}")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small d-block">Program Fee</span>
                                    <span class="fw-bold text-dark fs-5">₹@program.BaseFee.ToString("0")</span>
                                }
                            </div>

                            <a asp-page="/Student/Apply" asp-route-programId="@program.Id" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
                                Apply Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox display-1 text-muted opacity-25 mb-3 d-block"></i>
            <h4 class="fw-bold text-muted">No Opportunities Available</h4>
            <p class="text-muted">Check back later for new programs, internships, and courses!</p>
        </div>
    }
</div>