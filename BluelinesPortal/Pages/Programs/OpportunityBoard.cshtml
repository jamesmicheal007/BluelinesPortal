@page
@model BluelinesPortal.Pages.Programs.OpportunityBoardModel
@{
    ViewData["Title"] = "Opportunity Board";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
        display: inline-block;
    }

    .btn-gradient {
        background: var(--primary-gradient);
        color: white !important;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(220, 39, 67, 0.3);
        }

    /* Program Card Styles */
    .program-card {
        border: none;
        border-radius: 1.25rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .program-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

    .card-img-wrapper {
        position: relative;
        height: 200px;
        width: 100%;
        background-color: #f8f9fa;
        overflow: hidden;
    }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .program-card:hover .card-img-wrapper img {
        transform: scale(1.05);
    }

    .type-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: #dc2743;
        font-weight: 700;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        z-index: 2;
    }

    .feature-list li {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: #4a5568;
    }

    .feature-icon {
        width: 24px;
        color: #dc2743;
    }

    /* Search & Filter Bar Styles */
    .filter-bar {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 50px;
        padding: 0.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: sticky;
        top: 80px; /* Sticks just below your header */
        z-index: 10;
    }

    .filter-btn {
        border-radius: 50px;
        font-weight: 600;
        padding: 0.6rem 1.5rem;
        color: #4a5568;
        background: transparent;
        border: none;
        transition: all 0.2s ease;
    }

        .filter-btn:hover {
            background: #f8f9fa;
            color: #dc2743;
        }

        .filter-btn.active {
            background: #dc2743; /* Matches the gradient vibe */
            color: white;
            box-shadow: 0 4px 10px rgba(220, 39, 67, 0.2);
        }

    .search-input {
        border: none;
        background: transparent;
        box-shadow: none !important;
        font-weight: 500;
    }
</style>

<div class="bg-dark text-white rounded-4 p-5 mb-4 mt-3 position-relative overflow-hidden shadow">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: var(--primary-gradient); opacity: 0.1;"></div>
    <div class="position-relative z-index-2 text-center py-4">
        <span class="badge bg-white text-dark mb-3 px-3 py-2 rounded-pill fw-bold shadow-sm"><i class="bi bi-rocket-takeoff-fill text-danger me-1"></i> Bluelines Academy</span>
        <h1 class="display-4 fw-bold mb-3">Launch Your <span class="text-gradient">Tech Career</span></h1>
        <p class="lead opacity-75 mb-0 mx-auto" style="max-width: 700px;">Browse our active internships, major projects, and certification courses. Master modern tech stacks and earn verifiable credentials.</p>
    </div>
</div>

@if (Model.ActivePrograms != null && Model.ActivePrograms.Any())
{
    <div class="container-fluid mb-5">
        <div class="filter-bar d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3">

            <div class="d-flex flex-wrap justify-content-center gap-1 p-1">
                <button class="filter-btn active" data-filter="All">All Programs</button>
                <button class="filter-btn" data-filter="Course">Courses</button>
                <button class="filter-btn" data-filter="Internship">Internships</button>
                <button class="filter-btn" data-filter="MiniProject">Mini Projects</button>
                <button class="filter-btn" data-filter="MajorProject">Major Projects</button>
            </div>

            <div class="d-flex align-items-center bg-light rounded-pill px-4 py-2 flex-grow-1" style="max-width: 400px;">
                <i class="bi bi-search text-muted"></i>
                <input type="text" id="programSearch" class="form-control search-input ms-2" placeholder="Search technologies or titles...">
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-5 mb-5 pb-5" id="programsGrid">
        @foreach (var program in Model.ActivePrograms)
        {
            <div class="col program-item" data-type="@program.Type" data-title="@program.Title.ToLower() @program.ShortDescription?.ToLower()">
                <div class="program-card">
                    <div class="card-img-wrapper">
                        <div class="type-badge">
                            @if (program.Type.ToString() == "MiniProject")
                            {
                                <span>Mini Project</span>
                            }
                            else if (program.Type.ToString() == "MajorProject")
                            {

                                <span>Major Project</span>
                            }
                            else
                            {

                                <span>@program.Type</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(program.ThumbnailPath))
                        {
                            <img src="@program.ThumbnailPath" alt="@program.Title" />
                        }
                        else
                        {
                            <div class="d-flex h-100 justify-content-center align-items-center text-muted opacity-50">
                                <i class="bi bi-image display-1"></i>
                            </div>
                        }
                    </div>

                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="fw-bold text-dark mb-2">@program.Title</h4>
                        <p class="text-muted small mb-4 flex-grow-1">
                            @(string.IsNullOrEmpty(program.ShortDescription) ? "Comprehensive technical training and real-world project execution." : program.ShortDescription)
                        </p>

                        <ul class="list-unstyled feature-list mb-4 bg-light rounded-3 p-3">
                            <li>
                                <span class="feature-icon"><i class="bi bi-clock-history"></i></span>
                                <strong>Duration:</strong> <span class="ms-1">@program.DurationInDays Days</span>
                            </li>
                            <li>
                                <span class="feature-icon"><i class="bi bi-tag-fill"></i></span>
                                <strong>Tuition:</strong>
                                @if (program.BaseFee == 0)
                                {
                                    <span class="ms-1 badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">Free</span>
                                }
                                else
                                {
                                    <span class="ms-1 fw-bold">₹@program.BaseFee.ToString("0.00")</span>
                                }
                            </li>
                            @if (!string.IsNullOrEmpty(program.Prerequisites))
                            {
                                <li>
                                    <span class="feature-icon"><i class="bi bi-shield-check"></i></span>
                                    <strong>Requires:</strong> <span class="ms-1 text-truncate" title="@program.Prerequisites">@program.Prerequisites</span>
                                </li>
                            }
                        </ul>

                        <div class="d-flex gap-2 mt-auto">
                            <button type="button" class="btn btn-light border fw-bold w-50 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-@program.Id">
                                Details
                            </button>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a asp-page="/Student/Apply" asp-route-id="@program.Id" class="btn btn-gradient fw-bold w-50 shadow-sm">
                                    Apply Now
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark fw-bold w-50 shadow-sm">
                                    Sign In
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal-@program.Id" tabindex="-1" aria-labelledby="modalLabel-@program.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow-lg rounded-4">
                        <div class="modal-header border-bottom-0 pb-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-5 pb-5 pt-2">
                            <div class="text-center mb-4">
                                <span class="badge bg-dark mb-2 px-3 py-2 rounded-pill">
                                    @if (program.Type.ToString() == "MiniProject")
                                    {
                                        <span>Mini Project</span>
                                    }
                                    else if (program.Type.ToString() == "MajorProject")
                                    {

                                        <span>Major Project</span>
                                    }
                                    else
                                    {

                                        <span>@program.Type</span>
                                    }
                                </span>
                                <h2 class="fw-bold" id="modalLabel-@program.Id">@program.Title</h2>
                            </div>

                            @if (!string.IsNullOrEmpty(program.YouTubeVideoUrl) || !string.IsNullOrEmpty(program.BrochurePath))
                            {
                                <div class="d-flex justify-content-center gap-3 mb-4">
                                    @if (!string.IsNullOrEmpty(program.YouTubeVideoUrl))
                                    {
                                        <a href="@program.YouTubeVideoUrl" target="_blank" class="btn btn-outline-danger fw-bold rounded-pill px-4">
                                            <i class="bi bi-youtube me-2"></i> Watch Promo
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(program.BrochurePath))
                                    {
                                        <a href="@program.BrochurePath" target="_blank" class="btn btn-outline-primary fw-bold rounded-pill px-4">
                                            <i class="bi bi-file-earmark-pdf-fill me-2"></i> Syllabus PDF
                                        </a>
                                    }
                                </div>
                            }

                            <div class="bg-light p-4 rounded-4 mb-4">
                                <h6 class="fw-bold text-uppercase text-muted small mb-3">Program Overview</h6>
                                @if (!string.IsNullOrEmpty(program.Description))
                                {
                                    var paragraphs = program.Description.Split('\n');
                                    foreach (var p in paragraphs)
                                    {
                                        <p class="mb-2">@p</p>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted fst-italic">No detailed overview provided.</p>
                                }
                            </div>

                            <div class="text-center mt-5">
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <a asp-page="/Student/Apply" asp-route-id="@program.Id" class="btn btn-gradient btn-lg fw-bold rounded-pill px-5 shadow">
                                        Start Application Process <i class="bi bi-arrow-right ms-2"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark btn-lg fw-bold rounded-pill px-5 shadow">
                                        Log in to Apply
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noResultsMessage" class="text-center py-5 my-5" style="display: none;">
        <div class="bg-light rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 100px; height: 100px;">
            <i class="bi bi-search text-muted display-4"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">No Matches Found</h3>
        <p class="text-muted mx-auto" style="max-width: 500px;">We couldn't find any programs matching your search criteria. Try adjusting your filters or search terms.</p>
        <button class="btn btn-outline-dark rounded-pill mt-3 px-4 fw-bold" onclick="resetFilters()">Clear Filters</button>
    </div>
}
else
{
    <div class="col-12 text-center py-5 my-5">
        <div class="bg-light rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 100px; height: 100px;">
            <i class="bi bi-inbox text-muted display-4"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">No Open Programs</h3>
        <p class="text-muted mx-auto" style="max-width: 500px;">There are currently no programs open for enrollment. Please check back later or contact Bluelines Tech Solutions support.</p>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('programSearch');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const programItems = document.querySelectorAll('.program-item');
            const noResultsMessage = document.getElementById('noResultsMessage');

            // Listen for search input typing
            if(searchInput) {
                searchInput.addEventListener('input', filterPrograms);
            }

            // Listen for filter button clicks
            filterBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    // Update active styling
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    filterPrograms();
                });
            });

            // The core filtering logic
            function filterPrograms() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                const activeFilter = document.querySelector('.filter-btn.active').getAttribute('data-filter');
                let visibleCount = 0;

                programItems.forEach(item => {
                    const titleAndDesc = item.getAttribute('data-title');
                    const itemType = item.getAttribute('data-type');

                    const matchesSearch = titleAndDesc.includes(searchTerm);
                    const matchesFilter = (activeFilter === 'All') || (itemType === activeFilter);

                    if (matchesSearch && matchesFilter) {
                        item.style.display = 'block';
                        // Add a tiny fade-in effect
                        item.style.opacity = '1';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                        item.style.opacity = '0';
                    }
                });

                // Toggle "No Results" message
                if (visibleCount === 0) {
                    noResultsMessage.style.display = 'block';
                } else {
                    noResultsMessage.style.display = 'none';
                }
            }

            // Expose reset globally for the "Clear Filters" button
            window.resetFilters = function() {
                searchInput.value = '';
                filterBtns.forEach(b => b.classList.remove('active'));
                document.querySelector('[data-filter="All"]').classList.add('active');
                filterPrograms();
            }
        });
    </script>
}