@page "{applicationId:int}"
@model BluelinesPortal.Pages.Student.MakePaymentModel
@{
    ViewData["Title"] = "Fee Payment";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
</style>

<div class="mb-4">
    <a asp-page="/Dashboard/Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
    <h2 class="fw-bold mb-0">Program Fee Payment</h2>
    <p class="text-muted small">Pay your program fees via UPI or Bank Transfer and upload the proof.</p>
</div>

@if (Model.RemainingBalance <= 0)
{
    <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 text-center">
        <i class="bi bi-check-circle-fill display-4 text-success mb-3 d-block"></i>
        <h4 class="fw-bold">Fully Paid!</h4>
        <p class="mb-0">You have zero remaining balance for the <strong>@Model.ActiveApplication.Program.Title</strong> program. Thank you!</p>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        <div class="col-lg-5">
            <div class="glass-card p-4 h-100 border-top border-primary border-4">
                <h5 class="fw-bold mb-4">Official Payment Details</h5>

                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total Program Fee:</span>
                        <span class="fw-bold">₹@Model.ActiveApplication.Program.BaseFee.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Paid So Far:</span>
                        <span class="fw-bold text-success">₹@Model.TotalPaidSoFar.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 border-top">
                        <span class="text-danger fw-bold">Remaining Balance:</span>
                        <span class="fw-bold text-danger fs-5">₹@Model.RemainingBalance.ToString("N2")</span>
                    </div>
                </div>

                <div class="text-center mb-4 p-3 border rounded-3 bg-white">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3"><i class="bi bi-qr-code-scan me-1"></i> Scan to Pay via UPI</h6>

                    <img src="/images/upi-qr-placeholder.png" alt="UPI QR Code" class="img-fluid mb-3" style="max-width: 200px; border: 1px solid #ddd; padding: 10px; border-radius: 10px;" />

                    <p class="mb-0 font-monospace bg-light p-2 rounded fw-bold text-dark">bluelinestech@okicici</p>
                    <small class="text-muted">Google Pay / PhonePe / Paytm</small>
                </div>

                <div>
                    <h6 class="fw-bold text-muted text-uppercase small mb-2"><i class="bi bi-bank me-1"></i> Direct Bank Transfer</h6>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                            <span class="text-muted">Bank Name:</span> <strong>HDFC Bank</strong>
                        </li>
                        <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                            <span class="text-muted">Account Name:</span> <strong>Bluelines Tech Solutions</strong>
                        </li>
                        <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                            <span class="text-muted">Account No:</span> <strong class="font-monospace">50100234567890</strong>
                        </li>
                        <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                            <span class="text-muted">IFSC Code:</span> <strong class="font-monospace">HDFC0001234</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="glass-card p-4 p-lg-5 h-100">
                <h5 class="fw-bold mb-4"><i class="bi bi-cloud-arrow-up text-primary me-2"></i> Submit Payment Proof</h5>

                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="AmountToPay" class="form-label fw-bold small text-muted text-uppercase">Amount Transferred (₹) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold">₹</span>
                            <input asp-for="AmountToPay" type="number" step="0.01" max="@Model.RemainingBalance" class="form-control" required />
                        </div>
                        <div class="form-text">You can pay in full or submit a partial payment.</div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PaymentMethod" class="form-label fw-bold small text-muted text-uppercase">Payment Method <span class="text-danger">*</span></label>
                            <select asp-for="PaymentMethod" class="form-select form-select-lg" required>
                                <option value="UPI (GPay/PhonePe)">UPI (GPay/PhonePe)</option>
                                <option value="Bank Transfer">Bank Transfer (NEFT/IMPS)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UTRReference" class="form-label fw-bold small text-muted text-uppercase">Transaction / UTR No. <span class="text-danger">*</span></label>
                            <input asp-for="UTRReference" class="form-control form-control-lg" placeholder="e.g. 312345678901" required />
                        </div>
                    </div>

                    <div class="mb-5 bg-light p-4 rounded-4 border">
                        <label asp-for="PaymentScreenshot" class="form-label fw-bold text-primary"><i class="bi bi-camera me-1"></i> Upload Screenshot <span class="text-danger">*</span></label>
                        <input asp-for="PaymentScreenshot" type="file" class="form-control" accept="image/png, image/jpeg, application/pdf" required />
                        <div class="form-text mt-2">Upload the success screen showing the UTR/Reference number and date.</div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-pill shadow-sm">
                        Submit for Verification <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
}