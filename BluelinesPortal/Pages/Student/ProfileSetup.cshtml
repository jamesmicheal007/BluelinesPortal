@page
@model BluelinesPortal.Pages.Student.ProfileSetupModel
@{
    ViewData["Title"] = "Complete Your Profile";
    // Hide the standard layout navigation for this specific page
    Layout = "_Layout";
}

<style>
    header {
        display: none !important;
    }

    footer {
        display: none !important;
    }
</style>

<div class="row justify-content-center align-items-center min-vh-100 mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Welcome to Bluelines Tech!</h2>
            <p class="text-muted">Let's finish setting up your student profile before you apply for programs.</p>
        </div>

        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-body p-4">

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Profile.FullName" class="form-label fw-bold">Full Name</label>
                        <input asp-for="Profile.FullName" class="form-control form-control-lg" />
                        <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Profile.CollegeName" class="form-label fw-bold">College / University</label>
                        <input asp-for="Profile.CollegeName" class="form-control" placeholder="e.g., Cochin University of Science and Technology" />
                        <span asp-validation-for="Profile.CollegeName" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label asp-for="Profile.Degree" class="form-label fw-bold">Degree</label>
                            <input asp-for="Profile.Degree" class="form-control" placeholder="e.g., B.Tech CSE" />
                            <span asp-validation-for="Profile.Degree" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Profile.YearOfStudy" class="form-label fw-bold">Year of Study</label>
                            <select asp-for="Profile.YearOfStudy" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="1">1st Year</option>
                                <option value="2">2nd Year</option>
                                <option value="3">3rd Year</option>
                                <option value="4">4th Year</option>
                                <option value="5">Graduated</option>
                            </select>
                            <span asp-validation-for="Profile.YearOfStudy" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Profile.CurrentTechStack" class="form-label fw-bold">Current Tech Stack</label>
                        <input asp-for="Profile.CurrentTechStack" class="form-control" placeholder="e.g., HTML, CSS, C#, Python" />
                        <span asp-validation-for="Profile.CurrentTechStack" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Profile.GitHubProfileUrl" class="form-label fw-bold">GitHub Profile URL <span class="text-muted fw-normal">(Optional)</span></label>
                        <input asp-for="Profile.GitHubProfileUrl" type="url" class="form-control" placeholder="https://github.com/yourusername" />
                        <span asp-validation-for="Profile.GitHubProfileUrl" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Complete Profile</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}