@page
@model BluelinesPortal.Pages.VerifyModel
@{
    ViewData["Title"] = "Verify Certificate";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-8 col-lg-6 text-center">
        <h2 class="fw-bold mb-3">Credential Verification</h2>
        <p class="text-muted mb-4">Enter the Certificate ID found at the bottom of the document to verify its authenticity.</p>

        <!-- Search Form -->
        <form method="get" class="mb-5">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" name="id" class="form-control" placeholder="e.g., BLT-2026-A1B2C3" value="@Request.Query["id"]" required />
                <button type="submit" class="btn btn-primary px-4 fw-bold">Verify</button>
            </div>
        </form>

        <!-- Search Results -->
        @if (Model.SearchAttempted)
        {
            if (Model.VerifiedCertificate != null)
            {
                <div class="card border-0 shadow border-top border-success border-5 text-start">
                    <div class="card-body p-4 p-md-5 text-center">
                        <i class="bi bi-patch-check-fill text-success" style="font-size: 4rem;"></i>
                        <h3 class="fw-bold mt-3 text-success">Verified Official Document</h3>

                        <div class="bg-light p-4 rounded-3 mt-4 text-start">
                            <p class="text-muted small mb-1 text-uppercase fw-bold">Issued To</p>
                            <h4 class="mb-3">@Model.VerifiedCertificate.Application.Student.FullName</h4>

                            <p class="text-muted small mb-1 text-uppercase fw-bold">Program Completed</p>
                            <h5 class="mb-3 text-primary">@Model.VerifiedCertificate.Application.Program.Title</h5>

                            <p class="text-muted small mb-1 text-uppercase fw-bold">Issue Date</p>
                            <p class="mb-0 fw-bold">@Model.VerifiedCertificate.IssuedDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <p class="text-muted small mt-4 mb-0">This credential was issued by Bluelines Tech Solutions and is cryptographically linked to the student's executed coursework.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger shadow-sm border-0 py-4">
                    <i class="bi bi-x-circle-fill display-4 d-block mb-3"></i>
                    <h4 class="fw-bold">No Record Found</h4>
                    <p class="mb-0">We could not find a certificate matching that ID. Please check the spelling and try again.</p>
                </div>
            }
        }
    </div>
</div>