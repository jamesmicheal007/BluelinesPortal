@page
@model BluelinesPortal.Pages.Admin.Students.IndexModel
@{
    ViewData["Title"] = "Student Directory";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Student Directory</h2>
        <p class="text-muted small">Manage @Model.TotalStudents registered students across the platform.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-page-handler="ExportCsv" class="btn btn-success fw-bold shadow-sm rounded-pill px-4">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to Excel (CSV)
        </a>
    </div>
</div>

<div class="glass-card mb-4 p-3">
    <form method="get" class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" asp-for="SearchString" class="form-control border-start-0 bg-light" placeholder="Search by Name, ID, Email, or College...">
        </div>
        <button type="submit" class="btn btn-dark px-4 fw-bold shadow-sm">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchString))
        {
            <a asp-page="./Index" class="btn btn-outline-secondary px-3">Clear</a>
        }
    </form>
</div>

<div class="glass-card overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4"><a asp-route-SortOrder="@ViewData["IdSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Student ID <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th><a asp-route-SortOrder="@ViewData["NameSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Profile <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th>Contact Info</th>
                    <th class="text-center"><a asp-route-SortOrder="@ViewData["ProgramSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Active Enrollments <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Students.Any())
                {
                    foreach (var student in Model.Students)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@student.StudentId</td>
                            <td>
                                <div class="fw-bold text-dark">@student.FullName</div>
                                <div class="small text-muted"><i class="bi bi-building me-1"></i> @student.CollegeName</div>
                            </td>
                            <td>
                                <div class="small text-dark"><i class="bi bi-envelope me-1 text-muted"></i> @student.Email</div>
                                <div class="small text-dark"><i class="bi bi-telephone me-1 text-muted"></i> @student.Phone</div>
                            </td>
                            <td class="text-center">
                                @if (student.EnrolledPrograms > 0)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">@student.EnrolledPrograms Programs</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border rounded-pill px-3">None</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="./Details" asp-route-id="@student.ProfileId" class="btn btn-sm btn-primary fw-bold rounded-pill px-3 shadow-sm">
                                    View 360 Report <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">No students found matching your criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top-0">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-route-CurrentPage="@i" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">Next</a>
                </li>
            </ul>
        </div>
    }
</div>