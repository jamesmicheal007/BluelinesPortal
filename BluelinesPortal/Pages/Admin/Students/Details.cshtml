@page "{id:int}"
@model BluelinesPortal.Pages.Admin.Students.DetailsModel
@{
    ViewData["Title"] = "Student 360 Report";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .section-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6c757d;
        font-weight: 700;
        margin-bottom: 1rem;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <a asp-page="./Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Directory</a>
        <h2 class="fw-bold mb-0">Student 360 Report</h2>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-page-handler="DownloadReport" asp-route-id="@Model.Student.Id" class="btn btn-danger fw-bold shadow-sm rounded-pill px-4">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download PDF Dossier
        </a>
    </div>
</div>

<div class="row g-4 mb-5">

    <div class="col-lg-4">
        <div class="glass-card p-4 border-top border-primary border-4 mb-4">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-bounding-box display-5"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.Student.FullName</h4>
                <span class="badge bg-dark px-3 py-2 rounded-pill">ID: @Model.Student.StudentId</span>
            </div>

            <hr class="opacity-25 my-4">

            <div class="mb-3">
                <p class="text-muted small mb-1"><i class="bi bi-envelope me-2"></i> Email Address</p>
                <p class="fw-bold mb-0">@Model.Email</p>
            </div>
            <div class="mb-3">
                <p class="text-muted small mb-1"><i class="bi bi-telephone me-2"></i> Phone Number</p>
                <p class="fw-bold mb-0">@Model.Student.PhoneNumber</p>
            </div>
            <div class="mb-3">
                <p class="text-muted small mb-1"><i class="bi bi-building me-2"></i> Institution</p>
                <p class="fw-bold mb-0">@Model.Student.CollegeName</p>
            </div>
        </div>

        <div class="glass-card p-4 bg-success bg-opacity-10 border border-success border-opacity-25">
            <h6 class="text-success fw-bold text-uppercase mb-2">Lifetime Value</h6>
            <h2 class="fw-bold text-success mb-0">₹@Model.TotalPaid.ToString("N2")</h2>
            <p class="small text-success opacity-75 mt-2 mb-0">Total revenue generated from this student.</p>
        </div>
    </div>

    <div class="col-lg-8">

        <ul class="nav nav-pills mb-4 gap-2" id="studentTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill fw-bold px-4 shadow-sm border" data-bs-toggle="tab" data-bs-target="#programs" type="button"><i class="bi bi-rocket-takeoff me-1"></i> Programs</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold px-4 shadow-sm border" data-bs-toggle="tab" data-bs-target="#payments" type="button"><i class="bi bi-cash-stack me-1"></i> Payments</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold px-4 shadow-sm border" data-bs-toggle="tab" data-bs-target="#academics" type="button"><i class="bi bi-journal-code me-1"></i> Academics</button>
            </li>
        </ul>

        <div class="tab-content" id="studentTabsContent">

            <div class="tab-pane fade show active" id="programs" role="tabpanel">
                <div class="glass-card p-4">
                    <h6 class="section-title">Application History</h6>
                    @if (Model.Applications.Any())
                    {
                        <div class="list-group list-group-flush border-top">
                            @foreach (var app in Model.Applications)
                            {
                                <div class="list-group-item bg-transparent px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@app.Program.Title</h6>
                                            <span class="small text-muted">Applied: @app.AppliedOn.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill">@app.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic py-3">No program applications found.</p>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="payments" role="tabpanel">
                <div class="glass-card p-4">
                    <h6 class="section-title">Verified Transactions</h6>
                    @if (Model.Payments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-muted small">Date</th>
                                        <th class="text-muted small">Program</th>
                                        <th class="text-muted small">Gateway Ref</th>
                                        <th class="text-end text-muted small">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pay in Model.Payments)
                                    {
                                        <tr>
                                            <td><small class="fw-bold">@pay.PaymentDate.ToString("dd MMM yy")</small></td>
                                            <td><small>@pay.Application.Program.Title</small></td>
                                            <td><code class="small text-muted">@pay.PaymentGatewayReference</code></td>
                                            <td class="text-end text-success fw-bold small">₹@pay.AmountPaid.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic py-3">No payment records found.</p>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="academics" role="tabpanel">
                <div class="glass-card p-4">
                    <h6 class="section-title">Project Submissions</h6>
                    @if (Model.Submissions.Any())
                    {
                        <div class="list-group list-group-flush border-top">
                            @foreach (var sub in Model.Submissions)
                            {
                                <div class="list-group-item bg-transparent px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0">@sub.SubmissionTitle</h6>
                                        @if (sub.ReviewStatus == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (sub.ReviewStatus == "Needs Revision")
                                        {

                                            <span class="badge bg-danger">Needs Work</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </div>
                                    <div class="small text-muted mb-2">@sub.Application.Program.Title &bull; Submitted: @sub.SubmittedOn.ToString("dd MMM yyyy")</div>
                                    <div class="d-flex gap-2 mt-2">
                                        <a href="@sub.GitHubLink" target="_blank" class="badge bg-dark text-decoration-none px-2 py-1"><i class="bi bi-github"></i> Repository</a>
                                        @if (!string.IsNullOrEmpty(sub.CloudDriveLink))
                                        {
                                            <a href="@sub.CloudDriveLink" target="_blank" class="badge bg-info text-dark text-decoration-none px-2 py-1"><i class="bi bi-cloud"></i> Drive</a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic py-3">No academic submissions on record.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>