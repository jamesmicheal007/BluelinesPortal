@page
@using BluelinesPortal.Models
@model BluelinesPortal.Pages.Admin.Programs.EditModel
@{
    ViewData["Title"] = "Update Program";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-10">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="./Index" class="btn btn-light border shadow-sm me-3"><i class="bi bi-arrow-left"></i></a>
            <h3 class="mb-0 fw-bold">Publish New Program</h3>
        </div>

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="EditProgram.Id" />
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">Core Details</h5>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Title" class="form-label fw-bold">Program Title</label>
                                <input asp-for="EditProgram.Title" class="form-control form-control-lg" placeholder="e.g. Full Stack Python React" required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditProgram.ShortDescription" class="form-label fw-bold">Short Catchy Description</label>
                                <input asp-for="EditProgram.ShortDescription" class="form-control" placeholder="1-2 sentences max..." />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="EditProgram.YouTubeVideoUrl" class="form-label fw-bold">YouTube Promo URL (Optional)</label>
                                    <input asp-for="EditProgram.YouTubeVideoUrl" class="form-control" placeholder="https://youtube.com/..." />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="EditProgram.Prerequisites" class="form-label fw-bold">Prerequisites</label>
                                    <input asp-for="EditProgram.Prerequisites" class="form-control" placeholder="e.g. Basic HTML" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Description" class="form-label fw-bold">Comprehensive Description</label>
                                <textarea asp-for="EditProgram.Description" class="form-control" rows="8" placeholder="Full syllabus, expectations, etc..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">Configuration</h5>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Type" class="form-label fw-bold text-muted small">PROGRAM TYPE</label>
                                <select asp-for="EditProgram.Type" class="form-select" asp-items="Html.GetEnumSelectList<ProgramType>()" required>
                                    <option value="">-- Select Type --</option>
                                </select>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <label asp-for="EditProgram.DurationInDays" class="form-label fw-bold text-muted small">DURATION</label>
                                    <div class="input-group">
                                        <input asp-for="EditProgram.DurationInDays" class="form-control" type="number" min="1" required />
                                        <span class="input-group-text">Days</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label asp-for="EditProgram.BaseFee" class="form-label fw-bold text-muted small">FEE (₹)</label>
                                    <input asp-for="EditProgram.BaseFee" class="form-control" type="number" step="0.01" min="0" required />
                                </div>
                            </div>

                            <div class="form-check form-switch mt-4 bg-light p-3 rounded">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="EditProgram.IsActive" checked>
                                <label class="form-check-label fw-bold" asp-for="EditProgram.IsActive">Publicly Visible</label>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">Media Uploads</h5>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary"><i class="bi bi-image me-1"></i> Thumbnail Image</label>
                                <input asp-for="ThumbnailUpload" type="file" class="form-control form-control-sm" accept="image/jpeg, image/png, image/webp" />
                                <div class="form-text">Ratio 16:9 recommended.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-danger"><i class="bi bi-file-pdf me-1"></i> Syllabus Brochure (PDF)</label>
                                <input asp-for="BrochureUpload" type="file" class="form-control form-control-sm" accept="application/pdf" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body d-flex justify-content-end p-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-2 fw-bold">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm"><i class="bi bi-cloud-upload me-2"></i> Update Program</button>
                </div>
            </div>
        </form>
    </div>
</div>