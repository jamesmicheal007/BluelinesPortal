@page
@using BluelinesPortal.Models
@model BluelinesPortal.Pages.Admin.Programs.EditModel
@{
    ViewData["Title"] = "Edit Program";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-10">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="./Index" class="btn btn-light border shadow-sm me-3"><i class="bi bi-arrow-left"></i></a>
            <h3 class="mb-0 fw-bold">Edit Program</h3>
        </div>

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="EditProgram.Id" />
            <div class="row g-4">
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">Core Details</h5>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Title" class="form-label fw-bold">Program Title</label>
                                <input asp-for="EditProgram.Title" class="form-control form-control-lg" required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditProgram.ShortDescription" class="form-label fw-bold">Short Description</label>
                                <input asp-for="EditProgram.ShortDescription" class="form-control" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="EditProgram.YouTubeVideoUrl" class="form-label fw-bold">YouTube Promo URL</label>
                                    <input asp-for="EditProgram.YouTubeVideoUrl" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="EditProgram.Prerequisites" class="form-label fw-bold">Prerequisites</label>
                                    <input asp-for="EditProgram.Prerequisites" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Description" class="form-label fw-bold">Comprehensive Description</label>
                                <textarea asp-for="EditProgram.Description" class="form-control" rows="8"></textarea>
                            </div>

                            <h5 class="fw-bold mt-5 mb-4 border-bottom pb-2">Media Uploads</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-primary"><i class="bi bi-image me-1"></i> Thumbnail Image</label>
                                    <input asp-for="ThumbnailUpload" type="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-danger"><i class="bi bi-file-pdf me-1"></i> Brochure (PDF)</label>
                                    <input asp-for="BrochureUpload" type="file" class="form-control form-control-sm" accept=".pdf" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">Program Configuration</h5>

                            <div class="mb-3">
                                <label asp-for="EditProgram.Type" class="form-label fw-bold text-muted small">PROGRAM TYPE</label>
                                <select asp-for="EditProgram.Type" class="form-select" asp-items="Html.GetEnumSelectList<ProgramType>()" required>
                                    <option value="">-- Select Type --</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label asp-for="EditProgram.DurationInDays" class="form-label fw-bold text-muted small">DURATION (DAYS)</label>
                                <input asp-for="EditProgram.DurationInDays" class="form-control" type="number" min="1" required />
                            </div>

                            <div class="p-3 bg-light rounded-3 border">
                                <div class="mb-3">
                                    <label asp-for="EditProgram.BaseFee" class="form-label fw-bold text-dark">Base Fee (₹)</label>
                                    <input asp-for="EditProgram.BaseFee" class="form-control form-control-lg text-success fw-bold" type="number" step="0.01" min="0" required />
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="EditProgram.IsDiscountActive" id="discountToggle">
                                    <label class="form-check-label fw-bold text-dark" for="discountToggle">Enable Discount Strategy</label>
                                </div>

                                <div id="discountConfig" style="display: none;">
                                    <div class="mb-2">
                                        <label asp-for="EditProgram.DiscountType" class="form-label text-muted small fw-bold">Discount Type</label>
                                        <select asp-for="EditProgram.DiscountType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
                                    </div>
                                    <div class="mb-2">
                                        <label asp-for="EditProgram.DiscountValue" class="form-label text-muted small fw-bold">Value (% or ₹)</label>
                                        <input asp-for="EditProgram.DiscountValue" class="form-control form-control-sm" type="number" step="0.01" min="0" />
                                    </div>
                                    <div class="mb-2">
                                        <label asp-for="EditProgram.CouponCode" class="form-label text-muted small fw-bold">Coupon Code (Optional)</label>
                                        <input asp-for="EditProgram.CouponCode" class="form-control form-control-sm font-monospace text-uppercase" placeholder="e.g. DIWALI50" />
                                        <div class="form-text" style="font-size: 0.7rem;">Leave blank to apply automatically to all students.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-check form-switch mt-4 p-3 bg-primary bg-opacity-10 rounded border border-primary border-opacity-25">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="EditProgram.IsActive" checked>
                                <label class="form-check-label fw-bold text-primary" asp-for="EditProgram.IsActive">Publicly Visible</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body d-flex justify-content-end p-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-2 fw-bold">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm"><i class="bi bi-cloud-upload me-2"></i> Update Program</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("discountToggle");
            const config = document.getElementById("discountConfig");

            function updateDiscountVisibility() {
                if (toggle.checked) {
                    config.style.display = "block";
                    // Add a tiny animation
                    config.style.opacity = 0;
                    setTimeout(() => config.style.opacity = 1, 50);
                    config.style.transition = "opacity 0.3s ease";
                } else {
                    config.style.display = "none";
                }
            }

            toggle.addEventListener("change", updateDiscountVisibility);
            updateDiscountVisibility(); // Run on page load
        });
    </script>
}