@page "{id:int}"
@model BluelinesPortal.Pages.Admin.Programs.DeleteModel
@{
    ViewData["Title"] = "Delete Program";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-lg border-top border-danger border-5">
            <div class="card-body p-5">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex p-4 mb-4">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                </div>

                <h3 class="fw-bold mb-3">Delete "@Model.DeleteProgram.Title"?</h3>
                <p class="text-muted mb-4">
                    You are about to permanently remove this program from the database.
                    <strong>If students have already applied for or enrolled in this program, deleting it will corrupt their application history.</strong>
                </p>

                <div class="bg-light p-3 rounded mb-4 text-start">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Safer Alternative</p>
                    <p class="mb-0 small text-dark">Instead of deleting, consider editing the program and toggling the <strong>"Publicly Visible"</strong> switch off. This hides it from new students while preserving historical records.</p>
                </div>

                <form method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" asp-for="DeleteProgram.Id" />
                    <a asp-page="./Index" class="btn btn-light border px-4 fw-bold">Cancel & Go Back</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm"><i class="bi bi-trash me-2"></i> Force Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>