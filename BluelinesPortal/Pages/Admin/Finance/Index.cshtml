@page
@model BluelinesPortal.Pages.Admin.Finance.IndexModel
@{
    ViewData["Title"] = "Financial Ledger";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .btn-gradient {
        background: var(--primary-gradient);
        color: white !important;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(220, 39, 67, 0.3);
        }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Financial Ledger</h2>
        <p class="text-muted small">Track revenue, manage manual payments, and generate receipts.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <button class="btn btn-light fw-bold shadow-sm border" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <a asp-page="./ManualEntry" class="btn btn-gradient fw-bold shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Log Payment
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="glass-card p-4 border-bottom border-success border-4 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase fw-bold small mb-1">Total Verified Revenue</h6>
                    <h2 class="mb-0 text-success fw-bold">₹@Model.TotalRevenue.ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glass-card p-4 border-bottom border-primary border-4 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase fw-bold small mb-1">Successful Transactions</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalTransactions</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="glass-card mb-4 p-3">
    <form method="get" class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" asp-for="SearchString" class="form-control border-start-0 bg-light" placeholder="Search by Student, Gateway Ref, or Program...">
        </div>
        <button type="submit" class="btn btn-dark px-4 fw-bold shadow-sm">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchString))
        {
            <a asp-page="./Index" class="btn btn-outline-secondary px-3">Clear</a>
        }
    </form>
</div>

<div class="glass-card overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4"><a asp-route-SortOrder="@ViewData["DateSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Date & Time <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th><a asp-route-SortOrder="@ViewData["NameSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Student Name <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th>Program & Gateway Ref</th>
                    <th class="text-end"><a asp-route-SortOrder="@ViewData["AmountSort"]" asp-route-SearchString="@Model.SearchString" class="text-dark text-decoration-none">Amount <i class="bi bi-arrow-down-up small text-muted"></i></a></th>
                    <th class="text-end pe-4">Receipt</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentPayments != null && Model.RecentPayments.Any())
                {
                    foreach (var payment in Model.RecentPayments)
                    {
                        <tr class="@(payment.PaymentStatus == "PendingVerification" ? "bg-warning bg-opacity-10" : "")">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@payment.PaymentDate.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@payment.PaymentDate.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@payment.Application.Student.FullName</div>
                                <div class="small text-primary fw-bold">@payment.Application.Student.StudentId</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@payment.Application.Program.Title</div>
                                <code class="text-muted">@payment.PaymentGatewayReference</code>
                            </td>
                            <td class="text-end fw-bold @(payment.PaymentStatus == "Success" ? "text-success" : "text-dark")">
                                ₹@payment.AmountPaid.ToString("N2")
                                @if (payment.PaymentStatus == "PendingVerification")
                                {
                                    <div class="small text-warning mt-1"><i class="bi bi-clock-history"></i> Needs Review</div>
                                }
                                else if (payment.PaymentStatus == "Rejected")
                                {
                                    <div class="small text-danger mt-1"><i class="bi bi-x-circle"></i> Rejected</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (payment.PaymentStatus == "PendingVerification")
                                {
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="@payment.ScreenshotPath" target="_blank" class="btn btn-sm btn-info text-dark fw-bold rounded-pill shadow-sm" title="View Proof">
                                            <i class="bi bi-eye"></i> Proof
                                        </a>
                                        <form method="post" asp-page-handler="VerifyPayment" class="d-inline">
                                            <input type="hidden" name="paymentId" value="@payment.Id" />
                                            <input type="hidden" name="action" value="Approve" />
                                            <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill shadow-sm" title="Approve"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <form method="post" asp-page-handler="VerifyPayment" class="d-inline">
                                            <input type="hidden" name="paymentId" value="@payment.Id" />
                                            <input type="hidden" name="action" value="Reject" />
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold rounded-pill shadow-sm" title="Reject"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    </div>
                                }
                                else if (payment.PaymentStatus == "Success")
                                {
                                    <div class="btn-group shadow-sm">
                                        <a asp-page="./Receipt" asp-route-id="@payment.Id" class="btn btn-sm btn-light border text-primary" title="View Web Receipt">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-page="./Receipt" asp-page-handler="DownloadPdf" asp-route-id="@payment.Id" class="btn btn-sm btn-light border text-danger" title="Download PDF">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-search display-4 d-block mb-3 opacity-50"></i>
                            No payment records found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top-0">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-route-CurrentPage="@i" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">Next</a>
                </li>
            </ul>
        </div>
    }
</div>