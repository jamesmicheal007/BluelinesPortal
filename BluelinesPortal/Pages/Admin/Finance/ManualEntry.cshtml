@page
@model BluelinesPortal.Pages.Admin.Finance.ManualEntryModel
@{
    ViewData["Title"] = "Record Manual Payment";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
</style>

<div class="mb-4">
    <a asp-page="./Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Ledger</a>
    <h2 class="fw-bold mb-0">Record Offline Payment</h2>
    <p class="text-muted small">Log a manual transaction to move a student from Approved to Enrolled.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="glass-card p-4 p-md-5 border-top border-primary border-4">
            <form method="post" enctype="multipart/form-data">

                <h5 class="fw-bold mb-4 border-bottom pb-2">Student Information</h5>
                <div class="mb-4">
                    <label asp-for="NewPayment.StudentApplicationId" class="form-label fw-bold text-muted small text-uppercase">Select Approved Application <span class="text-danger">*</span></label>
                    <select asp-for="NewPayment.StudentApplicationId" asp-items="Model.ApprovedApplications" class="form-select form-select-lg" required>
                        <option value="">-- Search for a Student --</option>
                    </select>
                </div>

                <h5 class="fw-bold mb-4 mt-5 border-bottom pb-2">Transaction Details</h5>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="NewPayment.AmountPaid" class="form-label fw-bold text-muted small text-uppercase">Amount Collected (₹) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold">₹</span>
                            <input asp-for="NewPayment.AmountPaid" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NewPayment.PaymentMethod" class="form-label fw-bold text-muted small text-uppercase">Payment Method <span class="text-danger">*</span></label>
                        <select asp-for="NewPayment.PaymentMethod" class="form-select form-select-lg" id="paymentMethodSelect" required>
                            <option value="Cash">Cash</option>
                            <option value="GPay">Google Pay (GPay)</option>
                            <option value="Account Transfer">Bank / Account Transfer</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4 bg-light p-4 rounded-4 border" id="screenshotContainer" style="display: none;">
                    <label asp-for="PaymentScreenshot" class="form-label fw-bold text-primary"><i class="bi bi-camera me-1"></i> Upload Payment Proof</label>
                    <input asp-for="PaymentScreenshot" type="file" class="form-control" accept="image/png, image/jpeg, application/pdf" id="screenshotInput" />
                    <div class="form-text mt-2">Required for GPay and Bank Transfers. Attach the screenshot or PDF receipt.</div>
                </div>

                <div class="d-grid mt-5">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm rounded-pill py-3">
                        <i class="bi bi-check-circle-fill me-2"></i> Save Record & Generate Receipt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const methodSelect = document.getElementById("paymentMethodSelect");
            const screenshotContainer = document.getElementById("screenshotContainer");
            const screenshotInput = document.getElementById("screenshotInput");

            function toggleScreenshotRequirement() {
                if (methodSelect.value === "GPay" || methodSelect.value === "Account Transfer") {
                    screenshotContainer.style.display = "block";
                    screenshotInput.setAttribute("required", "required");
                } else {
                    screenshotContainer.style.display = "none";
                    screenshotInput.removeAttribute("required");
                }
            }

            toggleScreenshotRequirement();
            methodSelect.addEventListener("change", toggleScreenshotRequirement);
        });
    </script>
}