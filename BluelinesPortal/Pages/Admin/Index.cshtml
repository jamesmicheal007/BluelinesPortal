@page
@model BluelinesPortal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Command Center";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-3px);
        }

    .metric-icon {
        width: 60px;
        height: 60px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
</style>

<div class="mb-5">
    <h2 class="fw-bold mb-1">Command Center</h2>
    <p class="text-muted small mb-0">Platform overview, revenue tracking, and pending actions.</p>
</div>

<div class="row g-4 mb-5">

    <div class="col-md-6 col-xl-3">
        <div class="glass-card p-4 h-100 d-flex align-items-center">
            <div class="metric-icon bg-success bg-opacity-10 text-success me-3">
                <i class="bi bi-currency-rupee"></i>
            </div>
            <div>
                <p class="text-muted small text-uppercase fw-bold mb-1">Total Revenue</p>
                <h3 class="fw-bold text-dark mb-0">₹@Model.TotalRevenue.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="glass-card p-4 h-100 d-flex align-items-center">
            <div class="metric-icon bg-primary bg-opacity-10 text-primary me-3">
                <i class="bi bi-laptop"></i>
            </div>
            <div>
                <p class="text-muted small text-uppercase fw-bold mb-1">Active Interns</p>
                <h3 class="fw-bold text-dark mb-0">@Model.ActiveInternships</h3>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="glass-card p-4 h-100 d-flex align-items-center">
            <div class="metric-icon bg-info bg-opacity-10 text-info me-3">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <p class="text-muted small text-uppercase fw-bold mb-1">Total Users</p>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalStudents</h3>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <a asp-page="/Admin/Marketplace/Orders" class="text-decoration-none">
            <div class="glass-card p-4 h-100 d-flex align-items-center border @(Model.PendingVerifications > 0 ? "border-danger border-2" : "border-light")">
                <div class="metric-icon @(Model.PendingVerifications > 0 ? "bg-danger text-white" : "bg-secondary bg-opacity-10 text-secondary") me-3">
                    <i class="bi bi-bell-fill"></i>
                </div>
                <div>
                    <p class="text-muted small text-uppercase fw-bold mb-1">Pending Actions</p>
                    <h3 class="fw-bold @(Model.PendingVerifications > 0 ? "text-danger" : "text-dark") mb-0">
                        @Model.PendingVerifications
                    </h3>
                </div>
            </div>
        </a>
    </div>

</div>

<div class="row g-4 mb-5">

    <div class="col-lg-8">
        <div class="glass-card p-4 h-100">
            <h5 class="fw-bold mb-4">30-Day Revenue Trend</h5>
            <div style="height: 300px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <h5 class="fw-bold mb-4">Quick Links</h5>

            <div class="d-grid gap-3">
                <a asp-page="/Admin/Marketplace/Index" class="btn btn-light border p-3 text-start fw-bold shadow-sm rounded-3">
                    <i class="bi bi-shop text-primary me-2 fs-5"></i> Manage Store
                </a>
                <a asp-page="/Admin/Programs/Index" class="btn btn-light border p-3 text-start fw-bold shadow-sm rounded-3">
                    <i class="bi bi-journal-code text-success me-2 fs-5"></i> Manage Programs
                </a>
                <a asp-page="/Admin/Submissions/Index" class="btn btn-light border p-3 text-start fw-bold shadow-sm rounded-3">
                    <i class="bi bi-check2-square text-info me-2 fs-5"></i> Grade Submissions
                </a>
                <a asp-page="/Admin/Students/Index" class="btn btn-light border p-3 text-start fw-bold shadow-sm rounded-3">
                    <i class="bi bi-person-lines-fill text-warning me-2 fs-5"></i> Student Directory
                </a>
            </div>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('revenueChart').getContext('2d');

        // Parse the JSON data sent from the C# Backend
        const labels = @Html.Raw(Model.ChartLabelsJson);
        const data = @Html.Raw(Model.ChartDataJson);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Revenue (₹)',
                    data: data,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    borderWidth: 3,
                    pointBackgroundColor: '#0d6efd',
                    pointBorderColor: '#ffffff',
                    pointRadius: 4,
                    fill: true,
                    tension: 0.4 // Makes the line curved and smooth!
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₹' + value;
                            }
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>