@page
@model BluelinesPortal.Pages.Admin.Marketplace.OrdersModel
@{
    ViewData["Title"] = "Sales Ledger";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <a asp-page="./Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Marketplace</a>
        <h2 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff text-primary me-2"></i> Sales & Orders Ledger</h2>
        <p class="text-muted small mb-0">Verify payments and grant access to digital products.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 fw-bold">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="glass-card overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Date & Order ID</th>
                    <th>Customer & Product</th>
                    <th>Payment Details</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AllOrders != null && Model.AllOrders.Any())
                {
                    foreach (var order in Model.AllOrders)
                    {
                        <!-- Highlight pending rows slightly -->
                        <tr class="@(order.OrderStatus == "PendingVerification" ? "bg-warning bg-opacity-10" : "")">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">#@order.Id</div>
                                <div class="small text-muted">@order.OrderDate.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@order.OrderDate.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary mb-1">@order.Student.FullName</div>
                                <div class="small fw-bold text-dark"><i class="bi bi-box-seam me-1"></i> @order.Product.Title</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">₹@order.AmountPaid.ToString("N2")</div>
                                <div class="small text-muted">@order.PaymentMethod</div>
                                @if (!string.IsNullOrEmpty(order.UTRNumber))
                                {
                                    <div class="small font-monospace text-muted mt-1">UTR: @order.UTRNumber</div>
                                }
                            </td>
                            <td>
                                @if (order.OrderStatus == "PendingVerification")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill border border-warning"><i class="bi bi-hourglass-split me-1"></i> Pending Verification</span>
                                }
                                else if (order.OrderStatus == "Success")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Success</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (!string.IsNullOrEmpty(order.ScreenshotPath))
                                    {
                                        <a href="@order.ScreenshotPath" target="_blank" class="btn btn-sm btn-info text-dark fw-bold rounded-pill shadow-sm" title="View Receipt">
                                            <i class="bi bi-image"></i>
                                        </a>
                                    }

                                    @if (order.OrderStatus == "PendingVerification")
                                    {
                                        <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <button type="submit" name="newStatus" value="Success" class="btn btn-sm btn-success fw-bold rounded-pill shadow-sm" title="Approve">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button type="submit" name="newStatus" value="Rejected" class="btn btn-sm btn-outline-danger fw-bold rounded-pill" title="Reject">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (order.BalanceStatus == "PendingVerification")
                                    {
                                        <div class="d-flex align-items-center bg-warning bg-opacity-10 border border-warning rounded-pill px-2 py-1 ms-2">
                                            <a href="@order.BalanceScreenshotPath" target="_blank" class="btn btn-sm btn-warning text-dark fw-bold rounded-circle shadow-sm me-2" title="View Balance Receipt">
                                                <i class="bi bi-image"></i>
                                            </a>
                                            <form method="post" asp-page-handler="VerifyBalance" class="m-0">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill shadow-sm">
                                                    Verify Balance
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt display-4 d-block mb-3 opacity-50"></i>
                            <h5 class="fw-bold">No Orders Yet</h5>
                            <p class="small">When students purchase your projects, their transactions will appear here.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>