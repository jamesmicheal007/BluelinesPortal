@page "{id:int}"
@model BluelinesPortal.Pages.Admin.Submissions.ReviewModel
@{
    ViewData["Title"] = "Grade Submission";
}

<div class="mb-4">
    <a asp-page="./Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Submissions</a>
    <h3 class="mt-2 fw-bold">Evaluate Milestone: @Model.SubmissionRecord.SubmissionTitle</h3>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light fw-bold py-3">
                <i class="bi bi-person-badge text-primary me-2"></i> Student Details
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1">Name</p>
                        <p class="fw-bold">@Model.SubmissionRecord.Application.Student.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1">Program</p>
                        <p class="fw-bold text-primary">@Model.SubmissionRecord.Application.Program.Title</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light fw-bold py-3">
                <i class="bi bi-code-slash text-success me-2"></i> Submitted Work
            </div>
            <div class="card-body">
                <div class="d-flex gap-3 mb-4">
                    @if (!string.IsNullOrEmpty(Model.SubmissionRecord.GitHubLink))
                    {
                        <a href="@Model.SubmissionRecord.GitHubLink" target="_blank" class="btn btn-outline-dark fw-bold">
                            <i class="bi bi-github me-2"></i> Open GitHub Repository
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.SubmissionRecord.CloudDriveLink))
                    {
                        <a href="@Model.SubmissionRecord.CloudDriveLink" target="_blank" class="btn btn-outline-primary fw-bold">
                            <i class="bi bi-cloud-arrow-down me-2"></i> Download Assets
                        </a>
                    }
                </div>

                <h6 class="fw-bold text-muted border-bottom pb-2">Student's Notes</h6>
                <div class="p-3 bg-light rounded text-dark" style="min-height: 100px; white-space: pre-wrap;">@(string.IsNullOrEmpty(Model.SubmissionRecord.StudentNotes) ? "No notes provided." : Model.SubmissionRecord.StudentNotes)</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm border-primary border-3 border-top-0 border-end-0 border-bottom-0">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-primary">Mentor Evaluation</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="SubmissionRecord.Id" />

                    <div class="mb-4">
                        <label asp-for="SubmissionRecord.ReviewStatus" class="form-label fw-bold">Final Verdict</label>
                        <select asp-for="SubmissionRecord.ReviewStatus" class="form-select form-select-lg">
                            <option value="Pending Review">Pending Review</option>
                            <option value="Needs Revision">Needs Revision (Request Changes)</option>
                            <option value="Approved">Approved (Pass Milestone)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SubmissionRecord.MentorFeedback" class="form-label fw-bold">Constructive Feedback</label>
                        <textarea asp-for="SubmissionRecord.MentorFeedback" class="form-control" rows="8" placeholder="Provide code review details, point out bugs, or encourage the student..."></textarea>
                        <div class="form-text mt-2">This feedback will be instantly visible in the student's workspace.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">Submit Evaluation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>