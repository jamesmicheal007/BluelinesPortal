@page
@model BluelinesPortal.Pages.Admin.Submissions.IndexModel
@{
    ViewData["Title"] = "Grade Submissions";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .filter-btn {
        border-radius: 50px;
        font-weight: 600;
        padding: 0.5rem 1.5rem;
        color: #4a5568;
        background: transparent;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .filter-btn:hover {
            background: #f8f9fa;
            color: #0d6efd;
        }

        .filter-btn.active {
            background: #0d6efd;
            color: white;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.2);
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Code Review Console</h2>
        <p class="text-muted small">Review GitHub repositories, provide feedback, and issue certificates.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0 bg-success bg-opacity-10 text-success fw-bold" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="glass-card mb-4 p-3 d-flex flex-wrap gap-2">
    <a asp-page="./Index" asp-route-StatusFilter="Pending" class="filter-btn @(Model.StatusFilter == "Pending" ? "active" : "")">Requires Grading</a>
    <a asp-page="./Index" asp-route-StatusFilter="Needs Revision" class="filter-btn @(Model.StatusFilter == "Needs Revision" ? "active" : "")">Pending Revisions</a>
    <a asp-page="./Index" asp-route-StatusFilter="Approved" class="filter-btn @(Model.StatusFilter == "Approved" ? "active" : "")">Approved & Certified</a>
    <a asp-page="./Index" asp-route-StatusFilter="All" class="filter-btn @(Model.StatusFilter == "All" ? "active" : "")">All Records</a>
</div>

<div class="glass-card overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Student & Program</th>
                    <th>GitHub Repository</th>
                    <th>Date Submitted</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.StudentSubmissions.Any())
                {
                    foreach (var sub in Model.StudentSubmissions)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark mb-0">@sub.Application.Student.FullName</div>
                                <div class="small text-primary fw-bold mb-1">@(sub.Application.Student.StudentId ?? "PENDING")</div>
                                <div class="small text-muted">@sub.Application.Program.Title</div>
                            </td>
                            <td>
                                <div class="fw-bold mb-1">@sub.SubmissionTitle</div>
                                <div class="d-flex gap-2">
                                    <a href="@sub.GitHubLink" target="_blank" class="badge bg-dark text-decoration-none px-2 py-1"><i class="bi bi-github"></i> GitHub</a>

                                    @if (!string.IsNullOrEmpty(sub.CloudDriveLink))
                                    {
                                        <a href="@sub.CloudDriveLink" target="_blank" class="badge bg-info text-dark text-decoration-none px-2 py-1"><i class="bi bi-cloud"></i> Drive</a>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@sub.SubmittedOn.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@sub.SubmittedOn.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                @if (sub.ReviewStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Awaiting Review</span>
                                }
                                else if (sub.ReviewStatus == "Needs Revision")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill"><i class="bi bi-arrow-counterclockwise me-1"></i> Needs Work</span>
                                }
                                else if (sub.ReviewStatus == "Approved")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-patch-check me-1"></i> Approved</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-primary btn-sm fw-bold shadow-sm rounded-pill px-3"
                                        data-bs-toggle="modal" data-bs-target="#gradeModal-@sub.Id">
                                    <i class="bi bi-pencil-square me-1"></i> Grade Work
                                </button>
                            </td>
                        </tr>

                        <div class="modal fade" id="gradeModal-@sub.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header bg-light border-bottom-0 pb-3 pt-4 px-4">
                                        <h5 class="fw-bold mb-0"><i class="bi bi-journal-code text-primary me-2"></i> Evaluate: @sub.SubmissionTitle</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form method="post" asp-page-handler="Grade">
                                        <div class="modal-body px-4 py-4">
                                            <input type="hidden" name="submissionId" value="@sub.Id" />

                                            <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-4">
                                                <div class="row align-items-center">
                                                    <div class="col-md-6">
                                                        <p class="text-muted small text-uppercase fw-bold mb-1">Student</p>
                                                        <div class="d-flex align-items-center">
                                                            <h6 class="fw-bold mb-0 me-2">@sub.Application.Student.FullName</h6>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill">
                                                                @(sub.Application.Student.StudentId ?? "PENDING")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 mt-3 mt-md-0 text-md-end">
                                                        <div class="d-flex justify-content-md-end gap-2">
                                                            <a href="@sub.GitHubLink" target="_blank" class="btn btn-dark btn-sm rounded-pill fw-bold">
                                                                <i class="bi bi-github"></i> GitHub <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.7rem;"></i>
                                                            </a>
                                                            @if (!string.IsNullOrEmpty(sub.CloudDriveLink))
                                                            {
                                                                <a href="@sub.CloudDriveLink" target="_blank" class="btn btn-info text-dark btn-sm rounded-pill fw-bold">
                                                                    <i class="bi bi-cloud"></i> Drive <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.7rem;"></i>
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(sub.StudentNotes))
                                                {
                                                    <hr class="border-primary opacity-25">
                                                    <p class="text-muted small text-uppercase fw-bold mb-1">Student Notes</p>
                                                    <p class="mb-0 small fst-italic">"@sub.StudentNotes"</p>
                                                }
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label fw-bold">Mentor Feedback</label>
                                                <textarea name="mentorFeedback" class="form-control" rows="4" placeholder="Write constructive feedback for the student..." required>@sub.MentorFeedback</textarea>
                                                <div class="form-text">This feedback will appear directly in the student's workspace.</div>
                                            </div>

                                            <div>
                                                <label class="form-label fw-bold">Final Verdict</label>
                                                <select name="reviewStatus" class="form-select form-select-lg" required>
                                                    <option value="Needs Revision" selected="@(sub.ReviewStatus == "Needs Revision")">🔴 Needs Revision (Send back to student)</option>
                                                    <option value="Approved" selected="@(sub.ReviewStatus == "Approved")">🟢 Approved (Issue verified certificate)</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="modal-footer border-top-0 px-4 pb-4">
                                            <button type="button" class="btn btn-light fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary fw-bold shadow-sm px-4"><i class="bi bi-send-fill me-2"></i> Submit Grade</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <div class="bg-light rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-check-all display-5 text-success opacity-50"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Inbox Zero!</h5>
                            <p class="mb-0">There are no submissions currently matching this status.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>