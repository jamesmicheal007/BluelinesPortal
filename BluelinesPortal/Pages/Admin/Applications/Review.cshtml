@page "{id:int}"
@model BluelinesPortal.Pages.Admin.Applications.ReviewModel
@{
    ViewData["Title"] = "Review Application";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .skill-badge {
        width: 35px;
        height: 35px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        font-weight: bold;
    }
</style>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-page="./Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Inbox</a>
        <h2 class="fw-bold mb-0">Evaluate Applicant</h2>
    </div>
    <div>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-4 py-2 fs-6 rounded-pill">Status: @Model.ApplicationRecord.Status</span>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Student Profile Snapshot -->
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100 border-top border-primary border-4">
            <h5 class="fw-bold text-muted small text-uppercase mb-4">Candidate Profile</h5>
            <div class="d-flex align-items-center mb-4">
                <div class="bg-light rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-person-fill fs-2 text-primary"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@Model.ApplicationRecord.Student.FullName</h4>
                    <span class="badge bg-dark mt-1">ID: @(Model.ApplicationRecord.Student.StudentId ?? "NEW")</span>
                </div>
            </div>

            <ul class="list-group list-group-flush small">
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between"><span class="text-muted">Email:</span> <strong>@Model.StudentEmail</strong></li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between"><span class="text-muted">Phone:</span> <strong>@Model.ApplicationRecord.Student.PhoneNumber</strong></li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between"><span class="text-muted">College:</span> <strong>@Model.ApplicationRecord.Student.CollegeName</strong></li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between"><span class="text-muted">Degree & Year:</span> <strong>@Model.ApplicationRecord.Student.DegreeProgram (@Model.ApplicationRecord.Student.CurrentYear)</strong></li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between"><span class="text-muted">Location:</span> <strong>@Model.ApplicationRecord.Student.City, @Model.ApplicationRecord.Student.Pincode</strong></li>
            </ul>
        </div>
    </div>

    <!-- Program & Financial Snapshot -->
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100 border-top border-success border-4">
            <h5 class="fw-bold text-muted small text-uppercase mb-4">Program & Financials</h5>
            <h4 class="fw-bold text-dark mb-1">@Model.ApplicationRecord.Program.Title</h4>
            <p class="text-muted mb-4"><i class="bi bi-calendar3 me-1"></i> Applied On: @Model.ApplicationRecord.AppliedOn.ToString("dd MMM yyyy, hh:mm tt")</p>

            <div class="bg-light p-3 rounded-3 border">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Standard Program Fee:</span>
                    <span class="text-dark text-decoration-line-through">₹@Model.ApplicationRecord.Program.BaseFee.ToString("N2")</span>
                </div>

                @if (Model.ApplicationRecord.FinalFee < Model.ApplicationRecord.Program.BaseFee)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span class="fw-bold"><i class="bi bi-tags-fill me-1"></i> Discount Applied:</span>
                        <span class="fw-bold">- ₹@((Model.ApplicationRecord.Program.BaseFee - Model.ApplicationRecord.FinalFee).ToString("N2"))</span>
                    </div>
                }

                <div class="d-flex justify-content-between pt-2 border-top">
                    <span class="text-primary fw-bold fs-6">Locked Final Fee:</span>
                    <span class="fw-bold text-primary fs-4">₹@Model.ApplicationRecord.FinalFee.ToString("N2")</span>
                </div>
            </div>

            <div class="mt-3">
                <span class="fw-bold text-muted small d-block mb-1">Hardware Status:</span>
                @if (Model.ApplicationRecord.HasLaptop)
                {
                    <span class="badge bg-success"><i class="bi bi-laptop me-1"></i> Student is bringing a personal laptop</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="bi bi-pc-display me-1"></i> Desktop allocation required</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Detailed Questionnaire -->
<div class="glass-card p-4 p-lg-5 mb-4">
    <h5 class="fw-bold mb-4 pb-2 border-bottom"><i class="bi bi-file-earmark-person text-primary me-2"></i> Applicant Questionnaire</h5>

    <div class="row g-5">
        <!-- Self-Assessed Skills -->
        <div class="col-md-4 border-end">
            <h6 class="fw-bold text-muted small text-uppercase mb-4">Self-Assessed Skills (1-5)</h6>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-bold text-dark">HTML / CSS</span>
                <span class="skill-badge @(Model.ApplicationRecord.SkillHtmlCss >= 4 ? "bg-success text-white" : Model.ApplicationRecord.SkillHtmlCss == 3 ? "bg-warning text-dark" : "bg-danger text-white")">@Model.ApplicationRecord.SkillHtmlCss</span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-bold text-dark">JavaScript</span>
                <span class="skill-badge @(Model.ApplicationRecord.SkillJavaScript >= 4 ? "bg-success text-white" : Model.ApplicationRecord.SkillJavaScript == 3 ? "bg-warning text-dark" : "bg-danger text-white")">@Model.ApplicationRecord.SkillJavaScript</span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-bold text-dark">Python</span>
                <span class="skill-badge @(Model.ApplicationRecord.SkillPython >= 4 ? "bg-success text-white" : Model.ApplicationRecord.SkillPython == 3 ? "bg-warning text-dark" : "bg-danger text-white")">@Model.ApplicationRecord.SkillPython</span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-bold text-dark">SQL / Databases</span>
                <span class="skill-badge @(Model.ApplicationRecord.SkillSql >= 4 ? "bg-success text-white" : Model.ApplicationRecord.SkillSql == 3 ? "bg-warning text-dark" : "bg-danger text-white")">@Model.ApplicationRecord.SkillSql</span>
            </div>
        </div>

        <!-- Long Form Answers -->
        <div class="col-md-8">
            <div class="mb-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-1">Previous Project Experience</h6>
                <p class="mb-0 bg-light p-3 rounded fst-italic">"@(Model.ApplicationRecord.ProjectDescription ?? "No previous projects mentioned.")"</p>
            </div>
            <div class="mb-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-1">Problem Solving Approach</h6>
                <p class="mb-0 fw-bold text-primary"><i class="bi bi-search me-1"></i> @Model.ApplicationRecord.ProblemSolvingApproach</p>
            </div>
            <div class="mb-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-1">Primary Tech Interests</h6>
                <p class="mb-0">@(Model.ApplicationRecord.TechInterests ?? "N/A")</p>
            </div>
            <div class="mb-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-1">Main Goal</h6>
                <p class="mb-0 fw-bold">@Model.ApplicationRecord.MainGoal</p>
            </div>
            <div>
                <h6 class="fw-bold text-muted small text-uppercase mb-1">Overall Expectations</h6>
                <p class="mb-0">@(Model.ApplicationRecord.InternshipExpectations ?? "N/A")</p>
            </div>
        </div>
    </div>
</div>

<!-- Admin Action Panel -->
@if (Model.ApplicationRecord.Status == BluelinesPortal.Models.ApplicationStatus.Pending || Model.ApplicationRecord.Status == BluelinesPortal.Models.ApplicationStatus.UnderReview)
{
    <div class="glass-card p-4 p-lg-5 bg-primary bg-opacity-10 border border-primary border-opacity-25">
        <h5 class="fw-bold text-primary mb-3">Final Decision</h5>

        <form method="post" asp-page-handler="UpdateStatus">
            <input type="hidden" name="id" value="@Model.ApplicationRecord.Id" />

            <div class="mb-4">
                <label class="form-label fw-bold">Internal Admin Notes (Hidden from Student)</label>
                <textarea name="adminNotes" class="form-control" rows="3" placeholder="Leave notes regarding why they were accepted/rejected...">@Model.ApplicationRecord.AdminNotes</textarea>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" name="newStatus" value="Approved" class="btn btn-success btn-lg fw-bold px-5 shadow-sm rounded-pill">
                    <i class="bi bi-check-circle-fill me-2"></i> Approve & Send Offer
                </button>
                <button type="submit" name="newStatus" value="Rejected" class="btn btn-outline-danger btn-lg fw-bold px-5 rounded-pill bg-white">
                    <i class="bi bi-x-circle-fill me-2"></i> Reject Applicant
                </button>
            </div>
        </form>
    </div>
}
else
{
    <div class="alert alert-secondary border border-secondary p-4 rounded-4 shadow-sm">
        <h5 class="fw-bold mb-2"><i class="bi bi-lock-fill me-2"></i> Decision Locked</h5>
        <p class="mb-2">This application has already been processed and is currently marked as <strong>@Model.ApplicationRecord.Status</strong>.</p>
        @if (!string.IsNullOrEmpty(Model.ApplicationRecord.AdminNotes))
        {
            <hr />
            <p class="mb-0 small"><strong class="text-uppercase text-muted">Your Notes:</strong> @Model.ApplicationRecord.AdminNotes</p>
        }
    </div>
}