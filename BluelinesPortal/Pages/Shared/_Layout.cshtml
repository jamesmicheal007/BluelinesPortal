<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bluelines Tech Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* The Instagram-style Gradient */
        :root {
            --ig-gradient: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        }

        /* Glassmorphism Header */
        .portal-header {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        /* Gradient Text Effect for Brand */
        .text-gradient {
            background: var(--ig-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent;
            display: inline-block;
        }

        /* Portal Nav Links */
        .portal-nav .nav-link {
            font-weight: 600;
            color: #4a5568;
            padding: 0.5rem 1rem !important;
            margin: 0 0.25rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .portal-nav .nav-link:hover {
                color: #dc2743;
                background-color: rgba(220, 39, 67, 0.05);
            }

        /* Portal Footer */
        .portal-footer {
            background-color: #0f1115;
            color: #8b92a5;
            position: relative;
            padding-top: 4rem;
            padding-bottom: 2rem;
            margin-top: auto; /* Pushes footer to bottom */
        }

            .portal-footer::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: var(--ig-gradient);
            }

            .portal-footer h5 {
                color: #ffffff;
                font-weight: 700;
                margin-bottom: 1.2rem;
            }

            .portal-footer ul {
                list-style: none;
                padding: 0;
            }

                .portal-footer ul li {
                    margin-bottom: 0.75rem;
                }

            .portal-footer a {
                color: #8b92a5;
                text-decoration: none;
                transition: color 0.2s;
            }

                .portal-footer a:hover {
                    color: #f09433;
                }

        .social-gradient-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #1a1d24;
            color: #fff;
            font-size: 1.2rem;
            transition: all 0.3s;
        }

            .social-gradient-icon:hover {
                background: var(--ig-gradient);
                color: white;
                transform: translateY(-3px);
            }

        /* Flexbox wrapper to keep footer at bottom */
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .main-content {
            flex: 1 0 auto;
        }
    </style>
</head>
<body>

    <!-- MODERN STUDENT PORTAL HEADER -->
    <header class="sticky-top portal-header shadow-sm">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container-fluid px-4">
                <!-- Portal Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <div class="rounded p-2 text-white d-flex align-items-center justify-content-center" style="background: var(--ig-gradient); width: 40px; height: 40px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Bluelines <span class="text-gradient">Portal</span></h4>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav">
                    <i class="bi bi-grid-3x3-gap-fill fs-3 text-gradient"></i>
                </button>

                <div class="collapse navbar-collapse" id="portalNav">
                    <ul class="navbar-nav portal-nav mx-auto mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Admin/Index"><i class="bi bi-graph-up text-primary me-1"></i> Analytics</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Admin/Programs/Index"><i class="bi bi-card-list text-primary me-1"></i> Programs</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Admin/Applications/Index"><i class="bi bi-inbox text-primary me-1"></i> Triage</a></li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Students/Index">
                                        <i class="bi bi-people-fill text-primary me-1"></i> Students
                                    </a>
                                </li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Admin/Submissions/Index"><i class="bi bi-pencil-square text-primary me-1"></i> Grading</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Admin/Finance/Index"><i class="bi bi-cash-stack text-primary me-1"></i> Finance</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Dashboard/Index"><i class="bi bi-speedometer2 text-primary me-1"></i> Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Programs/OpportunityBoard"><i class="bi bi-compass text-primary me-1"></i> Opportunities</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Workspace/Index"><i class="bi bi-code-slash text-primary me-1"></i> My Workspace</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Verify"><i class="bi bi-patch-check text-primary me-1"></i> Verify</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Programs/OpportunityBoard">Browse Programs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Verify">Verify Certificate</a></li>
                            <li class="nav-item"><a class="nav-link" href="https://bluelinestechsolutions.com/" target="_blank">Main Website <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.75rem;"></i></a></li>
                        }
                    </ul>

                    <!-- User Profile / Login Integration -->
                    <div class="d-flex align-items-center mt-3 mt-lg-0 border-start ps-lg-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT AREA -->
    <div class="container-fluid px-4 main-content">
        <main role="main" class="pb-5 pt-4">
            @RenderBody()
        </main>
    </div>

    <!-- MODERN STUDENT PORTAL FOOTER -->
    <footer class="portal-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-mortarboard-fill fs-3 text-gradient"></i>
                        <h4 class="fw-bold mb-0 text-white">Bluelines <span class="text-gradient">Portal</span></h4>
                    </div>
                    <p class="small pe-lg-4">The dedicated learning workspace for Bluelines Tech students. Track your milestones, connect with mentors, and earn verified credentials.</p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="#" class="social-gradient-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-gradient-icon"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="social-gradient-icon"><i class="bi bi-discord"></i></a>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Admin"))
                    {
                        <div class="col-lg-3 col-md-6">
                            <h5>Platform Management</h5>
                            <ul>
                                <li><a href="/Admin/Index"><i class="bi bi-chevron-right small me-1"></i> Analytics Dashboard</a></li>
                                <li><a href="/Admin/Programs/Index"><i class="bi bi-chevron-right small me-1"></i> Program Catalog</a></li>
                                <li><a href="/Programs/OpportunityBoard"><i class="bi bi-chevron-right small me-1"></i> Public Board</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5>Operations</h5>
                            <ul>
                                <li><a href="/Admin/Applications/Index"><i class="bi bi-inbox me-2"></i> Application Triage</a></li>
                                <li><a href="/Admin/Submissions/Index"><i class="bi bi-pencil-square me-2"></i> Grade Submissions</a></li>
                                <li><a href="/Admin/Finance/Index"><i class="bi bi-cash-stack me-2"></i> Financial Ledger</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-3 col-md-6">
                            <h5>My Workspace</h5>
                            <ul>
                                <li><a href="/Dashboard/Index"><i class="bi bi-chevron-right small me-1"></i> Student Dashboard</a></li>
                                <li><a href="/Programs/OpportunityBoard"><i class="bi bi-chevron-right small me-1"></i> Browse Opportunities</a></li>
                                <li><a href="/Workspace/Index"><i class="bi bi-chevron-right small me-1"></i> Submit Project Work</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5>Credentials</h5>
                            <ul>
                                <li><a href="/Verify"><i class="bi bi-patch-check text-success me-2"></i> Verify Certificate ID</a></li>
                                <li><a href="#"><i class="bi bi-download me-2"></i> Download Guidelines</a></li>
                                <li><a href="#"><i class="bi bi-shield-check me-2"></i> Honor Code</a></li>
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <div class="col-lg-3 col-md-6">
                        <h5>Quick Links</h5>
                        <ul>
                            <li><a href="/Index"><i class="bi bi-chevron-right small me-1"></i> Portal Home</a></li>
                            <li><a href="/Programs/OpportunityBoard"><i class="bi bi-chevron-right small me-1"></i> Browse Programs</a></li>
                            <li><a href="/Verify"><i class="bi bi-patch-check text-success me-2"></i> Verify a Certificate</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5>Account Access</h5>
                        <ul>
                            <li><a href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right me-2"></i> Sign In</a></li>
                            <li><a href="/Identity/Account/Register"><i class="bi bi-person-plus me-2"></i> Create Account</a></li>
                            <li><a href="https://bluelinestechsolutions.com/" target="_blank"><i class="bi bi-globe me-2"></i> Corporate Website</a></li>
                        </ul>
                    </div>
                }

                <div class="col-lg-2 col-md-6">
                    <h5>Support</h5>
                    <ul>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Report a Bug</a></li>
                        <li><a href="mailto:info@bluelinestechsolutions.com">Contact Us</a></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary opacity-25 mt-5 mb-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-0">&copy; @DateTime.Now.Year Bluelines Tech Solutions. All rights reserved.</p>
                <div class="mt-2 mt-md-0 d-flex gap-3">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Use</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>