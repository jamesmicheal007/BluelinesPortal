@page
@model BluelinesPortal.Pages.Marketplace.ProjectsModel
@{
    ViewData["Title"] = "Explore Projects";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        transition: transform 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.1);
        }

    .product-thumbnail {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
    }
</style>

<div class="row mb-4 align-items-center mt-4">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1">Project Library</h2>
        <p class="text-muted small mb-0">Showing @Model.Products.Count of @Model.TotalProjects projects.</p>
    </div>
    <div class="col-md-6 mt-3 mt-md-0">
        <!-- TOP SEARCH BAR -->
        <form method="get" class="d-flex gap-2">
            <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
            <input type="text" asp-for="SearchString" class="form-control rounded-pill px-4 shadow-sm" placeholder="Search tech stack, title...">
            <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">Search</button>
        </form>
    </div>
</div>

<div class="row g-4 mb-5">

    <!-- LEFT SIDEBAR: FILTERS -->
    <div class="col-lg-3">
        <div class="bg-white p-4 rounded-4 border shadow-sm position-sticky" style="top: 2rem;">
            <h6 class="fw-bold text-uppercase small text-muted mb-3"><i class="bi bi-funnel me-1"></i> Filter by Category</h6>

            <div class="list-group list-group-flush mb-4">
                <a asp-page="./Projects" asp-route-SearchString="@Model.SearchString" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3 @(Model.CategoryId == null ? "bg-primary bg-opacity-10 text-primary fw-bold" : "text-muted")">
                    All Categories
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-page="./Projects" asp-route-CategoryId="@cat.Id" asp-route-SearchString="@Model.SearchString" class="list-group-item list-group-item-action border-0 px-2 py-2 rounded-3 @(Model.CategoryId == cat.Id ? "bg-primary bg-opacity-10 text-primary fw-bold" : "text-muted")">
                        @cat.Name
                    </a>
                }
            </div>

            <a asp-page="./Projects" class="btn btn-light btn-sm w-100 fw-bold border rounded-pill">Clear All Filters</a>
        </div>
    </div>

    <!-- RIGHT CONTENT: GRID & PAGINATION -->
    <div class="col-lg-9">

        @if (Model.Products.Any())
        {
            <div class="row g-4 mb-5">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="glass-card h-100 d-flex flex-column position-relative">

                            @if (product.IsFree || product.Price == 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 mt-2 me-2 shadow-sm rounded-pill"><i class="bi bi-gift-fill me-1"></i> FREE</span>
                            }

                            <img src="@(product.ThumbnailPath ?? "/images/laptop-placeholder.png")" class="card-img-top product-thumbnail" alt="@product.Title">

                            <div class="card-body p-3 d-flex flex-column">
                                <span class="text-primary small fw-bold text-uppercase mb-1" style="font-size: 0.7rem;">@product.Category.Name</span>
                                <h6 class="fw-bold text-dark mb-2 line-clamp-2">@product.Title</h6>

                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">
                                        @(product.IsFree || product.Price == 0 ? "Free" : $"₹{product.Price.ToString("0")}")
                                    </span>
                                    <a asp-page="./Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- PAGINATION CONTROLS -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Project pagination">
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 me-2 fw-bold" asp-page="./Projects" asp-route-CategoryId="@Model.CategoryId" asp-route-SearchString="@Model.SearchString" asp-route-CurrentPage="@(Model.CurrentPage - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 fw-bold" asp-page="./Projects" asp-route-CategoryId="@Model.CategoryId" asp-route-SearchString="@Model.SearchString" asp-route-CurrentPage="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 ms-2 fw-bold" asp-page="./Projects" asp-route-CategoryId="@Model.CategoryId" asp-route-SearchString="@Model.SearchString" asp-route-CurrentPage="@(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                <i class="bi bi-search display-1 text-muted opacity-25 mb-3 d-block"></i>
                <h4 class="fw-bold text-muted">No projects found.</h4>
                <p class="text-muted">Try adjusting your filters or search terms.</p>
                <a asp-page="./Projects" class="btn btn-outline-dark rounded-pill fw-bold px-4 mt-2">View All Projects</a>
            </div>
        }
    </div>
</div>