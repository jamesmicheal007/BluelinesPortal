@page
@model BluelinesPortal.Pages.Marketplace.IndexModel
@{
    ViewData["Title"] = "Marketplace Hub";

    // 💡 Clever trick: Arrays to cycle through beautiful colors and icons dynamically!
    var themeColors = new[] { "primary", "info", "success", "danger", "warning text-dark", "secondary" };
    var themeIcons = new[] { "bi-bar-chart-line-fill", "bi-braces", "bi-cpu-fill", "bi-hdd-network-fill", "bi-window-sidebar", "bi-database-fill" };
    int loopIndex = 0;
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(13, 110, 253, 0.1);
        }

    .icon-box {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .category-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .category-link:hover .browse-text {
            color: #0d6efd !important;
            transform: translateX(5px);
        }

    .browse-text {
        transition: all 0.3s ease;
    }
</style>

<div class="text-center mb-5 mt-4">
    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3 tracking-wide">DIGITAL ASSETS & TEMPLATES</span>
    <h1 class="fw-bold text-dark mb-3 display-5">Explore Categories</h1>
    <p class="text-muted lead mx-auto" style="max-width: 600px;">Find Projects by Category. Browse our curated collection across every discipline.</p>
</div>

<div class="container mb-5 pb-5">
    <div class="row g-4 justify-content-center">

        @if (Model.Categories != null && Model.Categories.Any())
        {
            foreach (var cat in Model.Categories)
            {
                var color = themeColors[loopIndex % themeColors.Length];
                var icon = themeIcons[loopIndex % themeIcons.Length];

                <div class="col-md-6 col-lg-4">
                    <a asp-page="./Projects" asp-route-CategoryId="@cat.Id" class="category-link h-100">
                        <div class="glass-card p-4 h-100 position-relative d-flex flex-column">

                            <div class="icon-box bg-@color.Replace(" text-dark", "") bg-opacity-10 text-@color mb-4">
                                <i class="bi @icon"></i>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">@cat.Name</h5>
                            <p class="text-muted small flex-grow-1">@(cat.Description ?? "Explore premium source code and projects in this category.")</p>

                            <div class="browse-text fw-bold text-muted small mt-3">
                                Browse projects <i class="bi bi-arrow-right ms-1"></i>
                            </div>
                        </div>
                    </a>
                </div>

                loopIndex++;
            }
        }

        <div class="col-md-6 col-lg-4">
            <a asp-page="/Contact" class="category-link h-100">
                <div class="glass-card p-4 h-100 position-relative d-flex flex-column border-primary border">
                    <span class="badge bg-primary position-absolute top-0 end-0 mt-3 me-3 rounded-pill px-3 py-2 shadow-sm"><i class="bi bi-stars me-1"></i> New</span>

                    <div class="icon-box bg-primary text-white mb-4 shadow-sm">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Customized Projects</h5>
                    <p class="text-muted small flex-grow-1">Tailored solutions built to your exact requirements.</p>

                    <div class="browse-text fw-bold text-primary small mt-3">
                        Request a build <i class="bi bi-arrow-right ms-1"></i>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a asp-page="./Projects" class="category-link h-100">
                <div class="glass-card p-4 h-100 d-flex flex-column align-items-center justify-content-center text-center bg-dark border-0 text-white">
                    <div class="icon-box bg-white text-dark mb-3 rounded-circle shadow-sm">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-2">View All Projects</h5>
                    <p class="text-white-50 small mb-4">Explore our full library of premium source code.</p>

                    <span class="btn btn-light fw-bold rounded-pill px-4 shadow">
                        See all <i class="bi bi-arrow-right ms-1"></i>
                    </span>
                </div>
            </a>
        </div>

    </div>
</div>