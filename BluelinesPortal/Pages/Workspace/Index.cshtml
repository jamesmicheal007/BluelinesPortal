@page "{id:int?}"
@model BluelinesPortal.Pages.Workspace.IndexModel
@{
    ViewData["Title"] = "My Workspace";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }

    .btn-gradient {
        background: var(--primary-gradient);
        color: white !important;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(220, 39, 67, 0.3);
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    /* Custom Timeline Styles for History */
    .timeline {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 0;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 0.5rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 0.25rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        background: white;
        border: 2px solid #0d6efd;
        z-index: 1;
    }

    .timeline-item.approved::before { border-color: #198754; background: #198754; }
    .timeline-item.rejected::before { border-color: #dc3545; background: #dc3545; }
    .timeline-item.pending::before { border-color: #ffc107; background: #ffc107; }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 rounded-pill fw-bold">
            <i class="bi bi-laptop me-1"></i> Active Workspace
        </span>
        <h2 class="fw-bold mb-1">@Model.ActiveApplication.Program.Title</h2>
        <p class="text-muted small mb-0">Enrolled on @Model.ActiveApplication.AppliedOn.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-page="/Workspace/Learn" asp-route-programId="@Model.ActiveApplication.ProgramItemId" class="btn btn-dark fw-bold rounded-pill px-4 shadow-sm">
            <i class="bi bi-book-half me-2"></i> Open Course Player
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0 bg-success bg-opacity-10 text-success fw-bold" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-5">
    <div class="col-lg-5">
        <div class="glass-card p-4 h-100">
            @if (Model.IsProjectApproved)
            {
                <div class="text-center py-5">
                    <div class="bg-success bg-opacity-10 text-success d-inline-flex p-4 rounded-circle mb-4">
                        <i class="bi bi-trophy-fill display-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Program Completed!</h3>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 300px;">
                        Congratulations! Your mentor has approved your final submission. This workspace is now locked.
                    </p>
                    <a asp-page="/Student/DownloadCertificate" asp-route-id="@Model.ActiveApplication.Id" class="btn btn-gradient btn-lg fw-bold rounded-pill px-4 shadow-sm">
                        <i class="bi bi-patch-check-fill me-2"></i> Download Certificate
                    </a>
                </div>
            }
            else
            {
                <h5 class="fw-bold mb-4"><i class="bi bi-cloud-arrow-up text-primary me-2"></i> Submit Your Work</h5>
                <form method="post">
                    <input type="hidden" asp-for="NewSubmission.StudentApplicationId" value="@Model.ActiveApplication.Id" />

                    <div class="mb-3">
                        <label asp-for="NewSubmission.SubmissionTitle" class="form-label fw-bold small text-muted text-uppercase">Submission Title</label>
                        <input asp-for="NewSubmission.SubmissionTitle" class="form-control" placeholder="e.g., Week 1 UI Design, or Final Backend API" required />
                        <span asp-validation-for="NewSubmission.SubmissionTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewSubmission.GitHubLink" class="form-label fw-bold small text-muted text-uppercase">GitHub Repository URL <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-github"></i></span>
                            <input asp-for="NewSubmission.GitHubLink" type="url" class="form-control" placeholder="https://github.com/..." required />
                        </div>
                        <span asp-validation-for="NewSubmission.GitHubLink" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewSubmission.CloudDriveLink" class="form-label fw-bold small text-muted text-uppercase">Cloud Drive Link (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-cloud-check"></i></span>
                            <input asp-for="NewSubmission.CloudDriveLink" type="url" class="form-control" placeholder="Google Drive, OneDrive, or Figma URL" />
                        </div>
                        <div class="form-text small">Use this if you need to submit ZIP files, images, or designs.</div>
                        <span asp-validation-for="NewSubmission.CloudDriveLink" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewSubmission.StudentNotes" class="form-label fw-bold small text-muted text-uppercase">Notes for Mentor (Optional)</label>
                        <textarea asp-for="NewSubmission.StudentNotes" class="form-control" rows="4" placeholder="Explain your approach, or note any issues you faced..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm">
                        Commit Submission <i class="bi bi-send-fill ms-2"></i>
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <div class="glass-card p-4 h-100">
            <h5 class="fw-bold mb-4"><i class="bi bi-clock-history text-primary me-2"></i> Milestone History</h5>

            @if (Model.PastSubmissions != null && Model.PastSubmissions.Any())
            {
                <div class="timeline mt-4">
                    @foreach (var sub in Model.PastSubmissions)
                    {
                        string statusClass = sub.ReviewStatus == "Approved" ? "approved" :
                        sub.ReviewStatus == "Needs Revision" ? "rejected" : "pending";

                        <div class="timeline-item @statusClass">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0">@sub.SubmissionTitle</h6>
                                <span class="small text-muted">@sub.SubmittedOn.ToString("dd MMM yyyy")</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a href="@sub.GitHubLink" target="_blank" class="badge bg-dark text-decoration-none px-3 py-2 rounded-pill"><i class="bi bi-github me-1"></i> Repository</a>
                                @if (!string.IsNullOrEmpty(sub.CloudDriveLink))
                                {
                                    <a href="@sub.CloudDriveLink" target="_blank" class="badge bg-info text-dark text-decoration-none px-3 py-2 rounded-pill"><i class="bi bi-cloud me-1"></i> External Drive</a>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(sub.StudentNotes))
                            {
                                <div class="bg-light p-3 rounded-3 mb-3 small">
                                    <strong class="d-block mb-1 text-muted text-uppercase" style="font-size: 0.75rem;">Your Notes:</strong>
                                    <span class="fst-italic">"@sub.StudentNotes"</span>
                                </div>
                            }

                            <div class="card border-0 bg-primary bg-opacity-10 rounded-3">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="text-primary small text-uppercase"><i class="bi bi-person-badge me-1"></i> Mentor Review</strong>

                                        @if (sub.ReviewStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                                        }
                                        else if (sub.ReviewStatus == "Needs Revision")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-arrow-counterclockwise me-1"></i> Needs Revision</span>
                                        }
                                        else if (sub.ReviewStatus == "Approved")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Approved</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(sub.MentorFeedback))
                                    {
                                        <p class="mb-0 small text-dark">@sub.MentorFeedback</p>
                                    }
                                    else
                                    {
                                        <p class="mb-0 small text-muted fst-italic">Your mentor has not provided feedback yet.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 mt-4">
                    <i class="bi bi-rocket text-muted opacity-25 display-1 d-block mb-3"></i>
                    <h5 class="fw-bold text-muted">No Submissions Yet</h5>
                    <p class="small text-muted mx-auto" style="max-width: 300px;">When you commit your first phase or project link, it will appear here for your mentor to review.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}