@page
@model BluelinesPortal.Pages.Workspace.LibraryModel
@{
    ViewData["Title"] = "My Digital Library";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(13, 110, 253, 0.08);
        }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
    <div>
        <a asp-page="/Dashboard/Index" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
        <h2 class="fw-bold mb-1"><i class="bi bi-collection-play text-primary me-2"></i> My Digital Library</h2>
        <p class="text-muted small mb-0">Access all your purchased projects, source codes, and templates.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-page="/Marketplace/Index" class="btn btn-dark fw-bold shadow-sm rounded-pill px-4">
            <i class="bi bi-shop me-1"></i> Browse Store
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    @if (Model.MyLibrary != null && Model.MyLibrary.Any())
    {
        foreach (var order in Model.MyLibrary)
        {
            <div class="col-lg-6">
                <div class="glass-card p-4 h-100 d-flex flex-column border-top border-success border-4">

                    <div class="d-flex align-items-start mb-4">
                        @if (!string.IsNullOrEmpty(order.Product.ThumbnailPath))
                        {
                            <img src="@order.Product.ThumbnailPath" class="rounded-4 shadow-sm me-4 border" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-4 me-4 d-flex justify-content-center align-items-center border" style="width: 100px; height: 100px;">
                                <i class="bi bi-laptop display-4 text-muted opacity-25"></i>
                            </div>
                        }

                        <div class="flex-grow-1">
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-2 small fw-bold border border-success border-opacity-25">
                                <i class="bi bi-check-circle-fill me-1"></i> Verified Purchase
                            </span>
                            <h4 class="fw-bold text-dark mb-1">@order.Product.Title</h4>
                            <p class="text-muted small mb-0"><i class="bi bi-calendar-check me-1"></i> Claimed on @order.OrderDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>

                    <div class="bg-light p-4 rounded-4 border mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold small text-muted text-uppercase mb-0"><i class="bi bi-cloud-download me-1"></i> Downloadable Assets</h6>

                            @if (order.BalanceDue > 0)
                            {
                                if (order.BalanceStatus == "PendingVerification")
                                {
                                    <span class="badge bg-warning text-dark border border-warning"><i class="bi bi-hourglass-split me-1"></i> Verifying Balance...</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Balance Due: ₹@order.BalanceDue.ToString("0")</span>
                                }
                            }
                        </div>

                        @if (order.Product.Assets != null && order.Product.Assets.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var asset in order.Product.Assets)
                                {
                                    // 💡 THE LOCKING LOGIC: If it's a Premium file AND they still owe money, lock it!
                                    bool isLocked = asset.IsPremium && order.BalanceDue > 0;

                                    <div class="d-flex justify-content-between align-items-center p-3 bg-white border rounded-3 shadow-sm @(isLocked ? "opacity-75" : "")">
                                        <div class="fw-bold @(isLocked ? "text-muted" : "text-dark")">
                                            @if (isLocked)
                                            {
                                                <i class="bi bi-lock-fill text-danger me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-zip text-primary me-2"></i>
                                            }
                                            @asset.Title
                                        </div>

                                        @if (isLocked)
                                        {
                                            <button class="btn btn-sm btn-light fw-bold rounded-pill px-3 shadow-sm" disabled>
                                                Premium Locked
                                            </button>
                                        }
                                        else
                                        {
                                            if (!string.IsNullOrEmpty(asset.FilePath))
                                            {
                                                <a href="@asset.FilePath" target="_blank" class="btn btn-sm btn-primary fw-bold rounded-pill px-3 shadow-sm">
                                                    Download <i class="bi bi-download ms-1"></i>
                                                </a>
                                            }
                                            else if (!string.IsNullOrEmpty(asset.ExternalLink))
                                            {
                                                <a href="@asset.ExternalLink" target="_blank" class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3 shadow-sm">
                                                    Open Link <i class="bi bi-box-arrow-up-right ms-1"></i>
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            </div>

                            @if (order.BalanceDue > 0 && order.BalanceStatus != "PendingVerification")
                            {
                                <div class="mt-4 text-center">
                                    <a asp-page="/Marketplace/PayBalance" asp-route-orderId="@order.Id" class="btn btn-warning fw-bold rounded-pill shadow-sm px-4">
                                        <i class="bi bi-wallet2 me-2"></i> Pay ₹@order.BalanceDue.ToString("0") Balance to Unlock
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="mb-0 small text-muted fst-italic">No files have been uploaded for this project yet. Please check back later or contact support.</p>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-collection display-1 text-muted opacity-25 d-block mb-3"></i>
            <h4 class="fw-bold text-muted">Your Library is Empty</h4>
            <p class="text-muted mb-4">You haven't purchased or claimed any digital projects yet.</p>
            <a asp-page="/Marketplace/Index" class="btn btn-primary btn-lg fw-bold rounded-pill px-5 shadow-sm">
                Explore Marketplace
            </a>
        </div>
    }
</div>