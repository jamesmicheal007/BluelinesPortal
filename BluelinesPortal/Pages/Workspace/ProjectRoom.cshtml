@page "{id:int}"
@model BluelinesPortal.Pages.Workspace.ProjectRoomModel
@{
    ViewData["Title"] = "Project Workspace";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-page="./Index" class="text-decoration-none mb-2 d-inline-block"><i class="bi bi-arrow-left"></i> Back to Workspaces</a>
        <h2 class="fw-bold mb-0">@Model.ActiveProject.Program.Title Workspace</h2>
    </div>
    <div>
        <span class="badge bg-primary fs-6 py-2 px-3"><i class="bi bi-mortarboard-fill me-2"></i> Officially Enrolled</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="card shadow-sm border-0 border-top border-primary border-4">
            <div class="card-header bg-white pt-4 border-0">
                <h5 class="fw-bold"><i class="bi bi-cloud-upload text-primary me-2"></i> Submit New Work</h5>
                <p class="text-muted small mb-0">Upload your code links for milestone reviews.</p>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewSubmission.SubmissionTitle" class="form-label fw-bold">Milestone / Title</label>
                        <input asp-for="NewSubmission.SubmissionTitle" class="form-control" placeholder="e.g., Week 1 UI Design" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewSubmission.GitHubLink" class="form-label fw-bold">GitHub Repository URL</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-github"></i></span>
                            <input asp-for="NewSubmission.GitHubLink" type="url" class="form-control" placeholder="https://github.com/..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewSubmission.CloudDriveLink" class="form-label fw-bold">Cloud Drive Link (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-google"></i></span>
                            <input asp-for="NewSubmission.CloudDriveLink" type="url" class="form-control" placeholder="Google Drive or OneDrive link..." />
                        </div>
                        <div class="form-text">Ensure file access is set to 'Anyone with the link'.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewSubmission.StudentNotes" class="form-label fw-bold">Notes for your Mentor</label>
                        <textarea asp-for="NewSubmission.StudentNotes" class="form-control" rows="4" placeholder="Explain what you built, any bugs you are facing, etc."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                        Submit for Review
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Submission History</h5>

        @if (Model.SubmissionHistory != null && Model.SubmissionHistory.Any())
        {
            foreach (var sub in Model.SubmissionHistory)
            {
                <div class="card shadow-sm mb-3 border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@sub.SubmissionTitle</h5>
                            <span class="badge @(sub.ReviewStatus == "Approved" ? "bg-success" : (sub.ReviewStatus == "Pending Review" ? "bg-warning text-dark" : "bg-danger"))">
                                @sub.ReviewStatus
                            </span>
                        </div>

                        <p class="text-muted small mb-3"><i class="bi bi-calendar-check me-1"></i> Submitted on @sub.SubmittedOn.ToString("dd MMM yyyy 'at' HH:mm")</p>

                        <div class="bg-light p-3 rounded mb-3">
                            @if (!string.IsNullOrEmpty(sub.GitHubLink))
                            {
                                <a href="@sub.GitHubLink" target="_blank" class="btn btn-sm btn-outline-dark me-2 mb-2"><i class="bi bi-github me-1"></i> View Code</a>
                            }
                            @if (!string.IsNullOrEmpty(sub.CloudDriveLink))
                            {
                                <a href="@sub.CloudDriveLink" target="_blank" class="btn btn-sm btn-outline-primary mb-2"><i class="bi bi-cloud-arrow-down me-1"></i> Download Files</a>
                            }

                            @if (!string.IsNullOrEmpty(sub.StudentNotes))
                            {
                                <p class="mb-0 mt-2"><strong>My Notes:</strong> @sub.StudentNotes</p>
                            }
                        </div>
                        @if (sub.ReviewStatus == "Approved")
                        {
                            <div class="mt-3 text-end">
                                <a asp-page="/Student/DownloadCertificate" asp-route-id="@Model.ActiveProject.Id" class="btn btn-success shadow-sm fw-bold">
                                    <i class="bi bi-award-fill me-2"></i> Download Official Certificate
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(sub.MentorFeedback))
                        {
                            <div class="alert alert-info border-info border-opacity-25 mb-0">
                                <h6 class="alert-heading fw-bold"><i class="bi bi-chat-square-text me-2"></i> Mentor Feedback</h6>
                                <hr class="mt-1 mb-2">
                                <p class="mb-0">@sub.MentorFeedback</p>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0 fst-italic">Waiting for mentor review...</p>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded shadow-sm border-0">
                <i class="bi bi-inbox text-muted display-4"></i>
                <h5 class="mt-3 text-muted">No submissions yet.</h5>
                <p class="text-muted mb-0">Use the form to submit your first milestone.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}