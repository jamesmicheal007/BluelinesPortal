@page "{programId:int}/{lessonId:int?}"
@model BluelinesPortal.Pages.Workspace.LearnModel
@{
    ViewData["Title"] = Model.ActiveProgram?.Title + " - Learning Hub";
    // We hide the standard layout navigation for a distraction-free learning environment
    Layout = "_Layout";
}

<style>
    .learning-sidebar {
        height: calc(100vh - 80px);
        overflow-y: auto;
        background: #f8f9fa;
        border-right: 1px solid #e9ecef;
    }

    .lesson-link {
        display: block;
        padding: 0.75rem 1rem;
        color: #4a5568;
        text-decoration: none;
        border-radius: 0.5rem;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .lesson-link:hover {
            background: #e9ecef;
            color: #0d6efd;
        }

        .lesson-link.active {
            background: #0d6efd;
            color: white;
            font-weight: 600;
        }

    .video-container {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 aspect ratio */
        height: 0;
        overflow: hidden;
        border-radius: 1rem;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .premium-lock-banner {
        background: linear-gradient(135deg, #1a1d24 0%, #0f1115 100%);
        border-radius: 1rem;
        padding: 4rem 2rem;
        text-align: center;
        color: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
</style>

<div class="container-fluid p-0">
    <div class="row g-0">

        <div class="col-lg-3 col-xl-3 learning-sidebar p-3 d-none d-lg-block shadow-sm z-1">
            <a asp-page="/Dashboard/Index" class="text-decoration-none text-muted small fw-bold text-uppercase tracking-wide mb-4 d-block">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>

            <h5 class="fw-bold mb-4 text-dark pe-2">@Model.ActiveProgram.Title</h5>

            <div class="accordion accordion-flush" id="syllabusAccordion">
                @foreach (var module in Model.Curriculum)
                {
                    <div class="accordion-item bg-transparent border-0 mb-3">
                        <h2 class="accordion-header" id="heading-@module.Id">
                            <button class="accordion-button bg-white shadow-sm rounded-3 fw-bold text-dark @(Model.CurrentLesson?.ModuleId == module.Id ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.Id">
                                @module.Title
                            </button>
                        </h2>
                        <div id="collapse-@module.Id" class="accordion-collapse collapse @(Model.CurrentLesson?.ModuleId == module.Id ? "show" : "")">
                            <div class="accordion-body px-2 py-3">
                                @foreach (var lesson in module.Lessons)
                                {
                                    bool isAccessible = Model.IsEnrolled || lesson.IsFreePreview;

                                    <a asp-page="./Learn" asp-route-programId="@Model.ActiveProgram.Id" asp-route-lessonId="@lesson.Id"
                                       class="lesson-link d-flex align-items-center justify-content-between @(Model.CurrentLesson?.Id == lesson.Id ? "active" : "")">
                                        <span class="text-truncate pe-2">@lesson.Title</span>

                                        @if (lesson.IsFreePreview && !Model.IsEnrolled)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success rounded-pill" style="font-size: 0.7rem;">FREE</span>
                                        }
                                        else if (!isAccessible)
                                        {
                                            <i class="bi bi-lock-fill opacity-50"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-play-circle-fill opacity-75"></i>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-9 col-xl-9 p-4 p-lg-5" style="height: calc(100vh - 80px); overflow-y: auto;">

            @if (Model.CurrentLesson != null)
            {
                <div class="mb-4">
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-2 fw-bold px-3 py-2 rounded-pill">
                        @Model.CurrentLesson.Module.Title
                    </span>
                    <h2 class="fw-bold display-6">@Model.CurrentLesson.Title</h2>
                </div>

                @if (Model.HasAccessToCurrentLesson)
                {
                    @if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl))
                    {
                        <div class="video-container mb-5">
                            <iframe src="@Model.CurrentLesson.VideoUrl" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    }

                    <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm border mt-4 article-content">
                        @Html.Raw(Model.CurrentLesson.Content)
                    </div>
                }
                else
                {
                    <div class="premium-lock-banner my-5">
                        <div class="bg-warning bg-opacity-10 text-warning d-inline-flex p-4 rounded-circle mb-4">
                            <i class="bi bi-lock-fill display-4"></i>
                        </div>
                        <h2 class="fw-bold mb-3">Premium Content Locked</h2>
                        <p class="lead opacity-75 mb-5 mx-auto" style="max-width: 500px;">
                            This tutorial is part of the premium syllabus. Enroll in <strong>@Model.ActiveProgram.Title</strong> to unlock all video lectures, day planners, and project resources.
                        </p>

                        <a asp-page="/Student/Apply" asp-route-id="@Model.ActiveProgram.Id" class="btn btn-warning btn-lg fw-bold rounded-pill px-5 shadow">
                            <i class="bi bi-star-fill me-2"></i> Enroll Now to Unlock
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 mt-5">
                    <i class="bi bi-book text-muted opacity-25 display-1 mb-3 d-block"></i>
                    <h3 class="fw-bold text-muted">No Content Available</h3>
                    <p>The syllabus for this program is currently being updated.</p>
                </div>
            }
        </div>
    </div>
</div>