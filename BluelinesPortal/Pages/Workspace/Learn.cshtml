@page "{programId:int}"
@model BluelinesPortal.Pages.Workspace.LearnModel
@{
    ViewData["Title"] = "Learning Resources";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .glass-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(13, 110, 253, 0.08);
        }

    .asset-icon {
        width: 50px;
        height: 50px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
        font-size: 1.5rem;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
    <div>
        <a asp-page="/Workspace/Index" asp-route-id="@Model.ActiveApplication.Id" class="btn btn-light border shadow-sm rounded-pill px-3 fw-bold mb-3"><i class="bi bi-arrow-left me-1"></i> Back to Submission Room</a>
        <h2 class="fw-bold mb-1">Resource Center</h2>
        <p class="text-muted small mb-0">Download materials, source code, and assets for <strong>@Model.ActiveApplication.Program.Title</strong>.</p>
    </div>

    @if (!Model.IsFullyPaid)
    {
        <div class="mt-3 mt-md-0">
            <a asp-page="/Student/MakePayment" asp-route-applicationId="@Model.ActiveApplication.Id" class="btn btn-warning fw-bold shadow-sm rounded-pill px-4">
                <i class="bi bi-unlock-fill me-1"></i> Pay Fees to Unlock All
            </a>
        </div>
    }
</div>

@if (!Model.IsFullyPaid)
{
    <div class="alert alert-warning border border-warning shadow-sm rounded-4 p-4 mb-5 d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
        <div>
            <h6 class="fw-bold mb-1">Limited Access Mode</h6>
            <p class="mb-0 small text-dark">You are currently in <strong>Approved</strong> status. You can view free materials, but Premium assets (like final source code or private videos) are locked until your fee payment is verified.</p>
        </div>
    </div>
}

<div class="row g-4 mb-5">
    @if (Model.CourseMaterials != null && Model.CourseMaterials.Any())
    {
        foreach (var asset in Model.CourseMaterials)
        {
            // Determine Icon based on Asset Type
            string iconClass = "bi-file-earmark-text text-primary bg-primary";
            if (asset.AssetType == BluelinesPortal.Models.ProjectAssetType.SourceCode) { iconClass = "bi-file-earmark-code text-success bg-success"; }
            else if (asset.AssetType == BluelinesPortal.Models.ProjectAssetType.PowerPoint) { iconClass = "bi-file-earmark-slides text-warning bg-warning"; }
            else if (asset.AssetType == BluelinesPortal.Models.ProjectAssetType.HowToRunVideo || asset.AssetType == BluelinesPortal.Models.ProjectAssetType.IntroVideo) { iconClass = "bi-play-circle text-danger bg-danger"; }
            else if (asset.AssetType == BluelinesPortal.Models.ProjectAssetType.FinalDocument) { iconClass = "bi-file-earmark-pdf text-danger bg-danger"; }

            bool isLocked = asset.IsPremium && !Model.IsFullyPaid;

            <div class="col-md-6 col-lg-4">
                <div class="glass-card h-100 p-4 d-flex flex-column @(isLocked ? "opacity-75" : "")">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="asset-icon @iconClass bg-opacity-10">
                            <i class="bi @iconClass.Split(' ')[0]"></i>
                        </div>
                        <span class="badge bg-dark bg-opacity-10 text-dark rounded-pill px-3 py-2 border border-dark border-opacity-25 small">
                            @asset.AssetType
                        </span>
                    </div>

                    <h5 class="fw-bold text-dark mb-3 flex-grow-1">@asset.Title</h5>

                    <div class="mt-auto border-top pt-3">
                        @if (isLocked)
                        {
                            <button class="btn btn-light w-100 fw-bold text-muted disabled rounded-pill" disabled>
                                <i class="bi bi-lock-fill me-2"></i> Premium Locked
                            </button>
                        }
                        else
                        {
                            if (!string.IsNullOrEmpty(asset.FilePath))
                            {
                                <a href="@asset.FilePath" target="_blank" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm">
                                    <i class="bi bi-cloud-download-fill me-2"></i> Download File
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(asset.ExternalUrl))
                            {
                                <a href="@asset.ExternalUrl" target="_blank" class="btn btn-outline-dark w-100 fw-bold rounded-pill shadow-sm">
                                    <i class="bi bi-box-arrow-up-right me-2"></i> Open Link
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-folder-x display-1 text-muted opacity-25 d-block mb-3"></i>
            <h4 class="fw-bold text-muted">No Resources Yet</h4>
            <p class="text-muted small">Your mentor has not uploaded any downloadable assets or videos for this program yet.</p>
        </div>
    }
</div>